		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="sumpengurang_covid" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{faktor_pengurang_covid19}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
