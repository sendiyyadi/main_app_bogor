			<textField isBlankWhenNull="false">
				<reportElement stretchType="RelativeToTallestObject" x="403" y="0" width="47" height="17" uuid="3874d9b4-6965-4625-ad7d-6f60b9c73b7c"/>
				<box topPadding="0" leftPadding="2" rightPadding="0">
					<pen lineWidth="0.5"/>
