		<variableExpression><![CDATA[$F{pbb_terhutang_sppt}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="sumdenda_tot" class="java.lang.Double" calculation="Sum">
