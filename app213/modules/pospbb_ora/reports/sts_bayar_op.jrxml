<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sts_bayar_op" language="groovy" pageWidth="671" pageHeight="842" columnWidth="631" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0da6fd9c-98f6-4e0c-94d2-7bb91af684bd">
	<property name="ireport.zoom" value="1.0000000000000002"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="kd_propinsi" class="java.lang.String">
		<defaultValueExpression><![CDATA["32"]]></defaultValueExpression>
	</parameter>
	<parameter name="kd_dati2" class="java.lang.String">
		<defaultValueExpression><![CDATA["12"]]></defaultValueExpression>
	</parameter>
	<parameter name="kd_kecamatan" class="java.lang.String">
		<defaultValueExpression><![CDATA["050"]]></defaultValueExpression>
	</parameter>
	<parameter name="kd_kelurahan" class="java.lang.String">
		<defaultValueExpression><![CDATA["002"]]></defaultValueExpression>
	</parameter>
	<parameter name="kd_blok" class="java.lang.String">
		<defaultValueExpression><![CDATA["001"]]></defaultValueExpression>
	</parameter>
	<parameter name="no_urut" class="java.lang.String">
		<defaultValueExpression><![CDATA["0002"]]></defaultValueExpression>
	</parameter>
	<parameter name="kd_jns_op" class="java.lang.String">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH BAYAR AS (
SELECT SPP.KD_PROPINSI, SPP.KD_DATI2, SPP.KD_KECAMATAN,
SPP.KD_KELURAHAN, SPP.KD_BLOK, SPP.NO_URUT, SPP.KD_JNS_OP, SPP.THN_PAJAK_SPPT,
SUM(NVL(BYR.JML_SPPT_YG_DIBAYAR,0)) AS JML_BAYAR,
SUM(NVL(BYR.DENDA_SPPT,0)) AS JML_BAYAR_DENDA,
SUM(NVL(BYR.JML_SPPT_YG_DIBAYAR,0)-NVL(BYR.DENDA_SPPT,0)) AS JML_BAYAR_POKOK,
TO_CHAR(MAX(BYR.TGL_PEMBAYARAN_SPPT),'dd-mm-yyyy') AS TGL_BAYAR
FROM S_SPPT SPP
LEFT JOIN S_PEMBAYARAN_SPPT BYR ON BYR.KD_PROPINSI = SPP.KD_PROPINSI
AND BYR.KD_DATI2 = SPP.KD_DATI2 AND BYR.KD_KECAMATAN = SPP.KD_KECAMATAN
AND BYR.KD_KELURAHAN = SPP.KD_KELURAHAN AND BYR.KD_BLOK = SPP.KD_BLOK AND BYR.NO_URUT = SPP.NO_URUT
AND BYR.KD_JNS_OP = SPP.KD_JNS_OP AND BYR.THN_PAJAK_SPPT = SPP.THN_PAJAK_SPPT
AND BYR.JML_SPPT_YG_DIBAYAR>0
WHERE SPP.STATUS_PEMBAYARAN_SPPT<>'2'
AND SPP.KD_PROPINSI='$P!{kd_propinsi}' AND SPP.KD_DATI2='$P!{kd_dati2}'
AND SPP.KD_KECAMATAN='$P!{kd_kecamatan}' AND SPP.KD_KELURAHAN='$P!{kd_kelurahan}'
AND SPP.KD_BLOK='$P!{kd_blok}' AND SPP.NO_URUT='$P!{no_urut}' AND SPP.KD_JNS_OP='$P!{kd_jns_op}'
GROUP BY SPP.KD_PROPINSI, SPP.KD_DATI2, SPP.KD_KECAMATAN, SPP.KD_KELURAHAN, SPP.KD_BLOK,
SPP.NO_URUT, SPP.KD_JNS_OP, SPP.THN_PAJAK_SPPT
)
SELECT ROW_NUMBER() OVER (ORDER BY SPT.KD_PROPINSI, SPT.KD_DATI2, SPT.KD_KECAMATAN,
SPT.KD_KELURAHAN, SPT.KD_BLOK, SPT.NO_URUT, SPT.KD_JNS_OP, SPT.THN_PAJAK_SPPT DESC) AS RNUM,
SPT.KD_PROPINSI||'.'||SPT.KD_DATI2||'-'||SPT.KD_KECAMATAN||'.'||SPT.KD_KELURAHAN ||'-'|| SPT.KD_BLOK
||'.'||SPT.NO_URUT||'.'||SPT.KD_JNS_OP AS NOP,
NVL(DOP.JALAN_OP,'')||NVL(', '||DOP.BLOK_KAV_NO_OP,'') AS ALAMAT_OP,
DOP.RT_OP||'/'||DOP.RW_OP AS RT_RW_OP, KEL_OP.NM_KELURAHAN AS KELURAHAN_OP,
KEC_OP.NM_KECAMATAN AS KECAMATAN_OP, DT2_OP.NM_DATI2, SPT.NM_WP_SPPT,
NVL(SPT.JLN_WP_SPPT,'')||NVL(', '||SPT.BLOK_KAV_NO_WP_SPPT,'') AS ALAMAT_WP,
SPT.RT_WP_SPPT || '/' || SPT.RW_WP_SPPT AS RT_RW_WP, SPT.KELURAHAN_WP_SPPT AS KELURAHAN_WP,
SPT.KOTA_WP_SPPT AS KOTA_WP, SPT.THN_PAJAK_SPPT, SPT.LUAS_BUMI_SPPT AS  LUAS_TANAH,
SPT.NJOP_BUMI_SPPT AS NJOP_TANAH, SPT.LUAS_BNG_SPPT AS LUAS_BNG, SPT.NJOP_BNG_SPPT AS NJOP_BNG,
SPT.PBB_YG_HARUS_DIBAYAR_SPPT AS KETETAPAN, SPT.STATUS_PEMBAYARAN_SPPT AS STATUS_BAYAR,
DTL.JML_BAYAR,
CASE WHEN SPT.STATUS_PEMBAYARAN_SPPT<>'1' THEN
   FN_HIT_DENDA(SPT.PBB_YG_HARUS_DIBAYAR_SPPT,SYSDATE,SPT.TGL_JATUH_TEMPO_SPPT)
ELSE DTL.JML_BAYAR_DENDA END AS JML_DENDA,
(SPT.PBB_YG_HARUS_DIBAYAR_SPPT-(DTL.JML_BAYAR-DTL.JML_BAYAR_DENDA)) AS JML_SISA,
DTL.TGL_BAYAR
FROM BAYAR DTL
LEFT JOIN S_SPPT SPT ON DTL.KD_PROPINSI = SPT.KD_PROPINSI
AND DTL.KD_DATI2 = SPT.KD_DATI2 AND DTL.KD_KECAMATAN = SPT.KD_KECAMATAN
AND DTL.KD_KELURAHAN = SPT.KD_KELURAHAN AND DTL.KD_BLOK = SPT.KD_BLOK AND DTL.NO_URUT = SPT.NO_URUT
AND DTL.KD_JNS_OP = SPT.KD_JNS_OP AND DTL.THN_PAJAK_SPPT = SPT.THN_PAJAK_SPPT
LEFT JOIN S_DAT_OBJEK_PAJAK DOP ON DOP.KD_PROPINSI = SPT.KD_PROPINSI AND DOP.KD_DATI2 = SPT.KD_DATI2
AND DOP.KD_KECAMATAN = SPT.KD_KECAMATAN AND DOP.KD_KELURAHAN = SPT.KD_KELURAHAN
AND DOP.KD_BLOK = SPT.KD_BLOK AND DOP.NO_URUT = SPT.NO_URUT AND DOP.KD_JNS_OP = SPT.KD_JNS_OP
LEFT JOIN S_REF_KELURAHAN KEL_OP ON KEL_OP.KD_PROPINSI=SPT.KD_PROPINSI AND KEL_OP.KD_DATI2=SPT.KD_DATI2
AND KEL_OP.KD_KECAMATAN = SPT.KD_KECAMATAN AND KEL_OP.KD_KELURAHAN = SPT.KD_KELURAHAN
LEFT JOIN S_REF_KECAMATAN KEC_OP ON KEC_OP.KD_PROPINSI=SPT.KD_PROPINSI AND KEC_OP.KD_DATI2=SPT.KD_DATI2
AND KEC_OP.KD_KECAMATAN = SPT.KD_KECAMATAN
LEFT JOIN S_REF_DATI2 DT2_OP ON DT2_OP.KD_PROPINSI=SPT.KD_PROPINSI AND DT2_OP.KD_DATI2=SPT.KD_DATI2
ORDER BY SPT.KD_PROPINSI, SPT.KD_DATI2, SPT.KD_KECAMATAN, SPT.KD_KELURAHAN, SPT.KD_BLOK, SPT.NO_URUT,
SPT.KD_JNS_OP, SPT.THN_PAJAK_SPPT DESC]]>
	</queryString>
	<field name="RNUM" class="java.math.BigDecimal"/>
	<field name="NOP" class="java.lang.String"/>
	<field name="ALAMAT_OP" class="java.lang.String"/>
	<field name="RT_RW_OP" class="java.lang.String"/>
	<field name="KELURAHAN_OP" class="java.lang.String"/>
	<field name="KECAMATAN_OP" class="java.lang.String"/>
	<field name="NM_DATI2" class="java.lang.String"/>
	<field name="NM_WP_SPPT" class="java.lang.String"/>
	<field name="ALAMAT_WP" class="java.lang.String"/>
	<field name="RT_RW_WP" class="java.lang.String"/>
	<field name="KELURAHAN_WP" class="java.lang.String"/>
	<field name="KOTA_WP" class="java.lang.String"/>
	<field name="THN_PAJAK_SPPT" class="java.lang.String"/>
	<field name="LUAS_TANAH" class="java.math.BigDecimal"/>
	<field name="NJOP_TANAH" class="java.math.BigDecimal"/>
	<field name="LUAS_BNG" class="java.math.BigDecimal"/>
	<field name="NJOP_BNG" class="java.math.BigDecimal"/>
	<field name="KETETAPAN" class="java.math.BigDecimal"/>
	<field name="STATUS_BAYAR" class="java.lang.String"/>
	<field name="JML_BAYAR" class="java.math.BigDecimal"/>
	<field name="JML_DENDA" class="java.math.BigDecimal"/>
	<field name="JML_SISA" class="java.math.BigDecimal"/>
	<field name="TGL_BAYAR" class="java.lang.String"/>
	<variable name="sisa" class="java.lang.Double">
		<variableExpression><![CDATA[$F{KETETAPAN}-($F{JML_BAYAR}-$F{JML_DENDA})]]></variableExpression>
	</variable>
	<variable name="jml_bayar_1" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{JML_BAYAR}]]></variableExpression>
	</variable>
	<variable name="ketetapan_1" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{KETETAPAN}]]></variableExpression>
	</variable>
	<variable name="jml_denda_1" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{JML_DENDA}]]></variableExpression>
	</variable>
	<variable name="jml_sisa_1" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$V{sisa}]]></variableExpression>
	</variable>
