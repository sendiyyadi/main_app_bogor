	<field name="KD_KLS_TANAH" class="java.lang.String"/>
	<variable name="belum_bayar" class="java.lang.Double">
		<variableExpression><![CDATA[$F{PBB_YG_HARUS_DIBAYAR_SPPT}-$F{JML_SPPT_YG_DIBAYAR}]]></variableExpression>
	</variable>
