<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sppt_rpt" language="groovy" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="7e4c4947-3383-4c94-8927-c49abfb86d1b">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="432"/>
	<property name="ireport.background.image.properties" value="true,true,1.0,-8,-8,0,0,611,954"/>
	<parameter name="tahun_sppt" class="java.lang.String">
		<defaultValueExpression><![CDATA[2016]]></defaultValueExpression>
	</parameter>
	<parameter name="background_img" class="java.lang.String"/>
	<parameter name="terbilang_bayarpbb" class="java.lang.String"/>
	<parameter name="kd_prop" class="java.lang.String"/>
	<parameter name="kd_dati2" class="java.lang.String"/>
	<parameter name="kd_kecamatan" class="java.lang.String"/>
	<parameter name="kd_kelurahan" class="java.lang.String"/>
	<parameter name="kd_blok" class="java.lang.String"/>
	<parameter name="no_urut" class="java.lang.String"/>
	<parameter name="kd_jns_op" class="java.lang.String"/>
	<parameter name="nm_pejabat" class="java.lang.String"/>
	<parameter name="nip_pejabat" class="java.lang.String"/>
	<parameter name="img_qr" class="java.lang.String"/>
	<parameter name="blanko_back" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 'A' AS NO_BARIS, SUM(PBB_YG_HARUS_DIBAYAR_SPPT) OVER() AS SUM_POKOK_PBB,  SUM(DENDA_SPPT) OVER() AS SUM_DENDA_PBB, SUM(PBB_BELUM_BAYAR) OVER() AS SUM_BLM_BAYAR_PBB,BA.* FROM(
SELECT S.THN_PAJAK_SPPT, S.NM_WP_SPPT, S.JLN_WP_SPPT, S.BLOK_KAV_NO_WP_SPPT, S.RW_WP_SPPT, S.RT_WP_SPPT, S.KELURAHAN_WP_SPPT, S.KOTA_WP_SPPT,S.LUAS_BUMI_SPPT, S.NJOP_BUMI_SPPT, S.LUAS_BNG_SPPT, S.NJOP_BNG_SPPT,S.NJOP_SPPT,
S.NJOPTKP_SPPT, S.TARIF_SPPT, S.PBB_TERHUTANG_SPPT, S.FAKTOR_PENGURANG_SPPT, S.PBB_YG_HARUS_DIBAYAR_SPPT, PS.DENDA_SPPT,
PS.JML_SPPT_YG_DIBAYAR, PS.THN_PAJAK_SPPT AS THN_BAYAR_SPPT, TO_CHAR(S.TGL_CETAK_SPPT,'DD-MM-YYYY') AS TGL_CETAK_SPPT, (S.KD_PROPINSI||'.'||S.KD_DATI2||'.'||S.KD_KECAMATAN||'.'||S.KD_KELURAHAN||'.'||S.KD_BLOK||'-'||S.NO_URUT||'.'||S.KD_JNS_OP) AS NOP, OP.JALAN_OP
, OP.RW_OP, OP.RT_OP, KEC.NM_KECAMATAN, KEL.NM_KELURAHAN, S.KD_KLS_BNG, TO_CHAR(S.TGL_JATUH_TEMPO_SPPT,'DD-MM-YYYY') AS TGL_JATUH_TEMPO_SPPT,
CASE WHEN (S.PBB_YG_HARUS_DIBAYAR_SPPT-PS.JML_SPPT_YG_DIBAYAR) < 0 THEN 0 ELSE (S.PBB_YG_HARUS_DIBAYAR_SPPT-PS.JML_SPPT_YG_DIBAYAR) END AS PBB_BELUM_BAYAR, DT.NM_DATI2, S.KD_KLS_TANAH
 FROM SPPT S
JOIN PEMBAYARAN_SPPT PS ON (S.THN_PAJAK_SPPT=PS.THN_PAJAK_SPPT AND S.KD_KECAMATAN=PS.KD_KECAMATAN AND S.KD_KELURAHAN =PS.KD_KELURAHAN AND S.KD_BLOK = PS.KD_BLOK AND S.NO_URUT=PS.NO_URUT AND S.KD_JNS_OP=PS.KD_JNS_OP)
JOIN DAT_OBJEK_PAJAK OP ON (S.KD_PROPINSI=OP.KD_PROPINSI AND S.KD_DATI2=OP.KD_DATI2 AND S.KD_KECAMATAN=OP.KD_KECAMATAN AND S.KD_KELURAHAN =OP.KD_KELURAHAN AND S.KD_BLOK = OP.KD_BLOK AND S.NO_URUT=OP.NO_URUT AND S.KD_JNS_OP=OP.KD_JNS_OP)
JOIN REF_KECAMATAN KEC ON (S.KD_PROPINSI=KEC.KD_PROPINSI AND S.KD_DATI2=KEC.KD_DATI2 AND S.KD_KECAMATAN=KEC.KD_KECAMATAN)
JOIN REF_KELURAHAN KEL ON (S.KD_PROPINSI=KEL.KD_PROPINSI AND S.KD_DATI2=KEL.KD_DATI2 AND S.KD_KECAMATAN=KEL.KD_KECAMATAN AND S.KD_KELURAHAN=KEL.KD_KELURAHAN)
LEFT JOIN REF_DATI2 DT ON (S.KD_PROPINSI=DT.KD_PROPINSI AND S.KD_DATI2=DT.KD_DATI2)
WHERE S.KD_PROPINSI = $P{kd_prop} AND S.KD_DATI2=$P{kd_dati2} AND S.KD_KECAMATAN=$P{kd_kecamatan} AND S.KD_KELURAHAN = $P{kd_kelurahan} AND S.KD_BLOK = $P{kd_blok} AND S.NO_URUT=$P{no_urut} AND S.KD_JNS_OP=$P{kd_jns_op} AND S.THN_PAJAK_SPPT = $P{tahun_sppt} ORDER BY S.THN_PAJAK_SPPT DESC
) BA WHERE ROWNUM <= 6
UNION ALL
SELECT TO_CHAR(ROW_NUMBER() OVER (ORDER BY THN_PAJAK_SPPT DESC)) AS NO_BARIS, SUM(PBB_YG_HARUS_DIBAYAR_SPPT) OVER() AS SUM_POKOK_PBB,  SUM(DENDA_SPPT) OVER() AS SUM_DENDA_PBB, SUM(PBB_BELUM_BAYAR) OVER() AS SUM_BLM_BAYAR_PBB,BA.* FROM(
SELECT S.THN_PAJAK_SPPT, S.NM_WP_SPPT, S.JLN_WP_SPPT, S.BLOK_KAV_NO_WP_SPPT, S.RW_WP_SPPT, S.RT_WP_SPPT, S.KELURAHAN_WP_SPPT, S.KOTA_WP_SPPT,S.LUAS_BUMI_SPPT, S.NJOP_BUMI_SPPT, S.LUAS_BNG_SPPT, S.NJOP_BNG_SPPT,S.NJOP_SPPT,
S.NJOPTKP_SPPT, S.TARIF_SPPT, S.PBB_TERHUTANG_SPPT, S.FAKTOR_PENGURANG_SPPT, S.PBB_YG_HARUS_DIBAYAR_SPPT, PS.DENDA_SPPT,
PS.JML_SPPT_YG_DIBAYAR, PS.THN_PAJAK_SPPT AS THN_BAYAR_SPPT, TO_CHAR(S.TGL_CETAK_SPPT,'DD-MM-YYYY') AS TGL_CETAK_SPPT, (S.KD_PROPINSI||S.KD_DATI2||S.KD_KECAMATAN||S.KD_KELURAHAN||S.KD_BLOK||S.NO_URUT||S.KD_JNS_OP) AS NOP, OP.JALAN_OP
, OP.RW_OP, OP.RT_OP, KEC.NM_KECAMATAN, KEL.NM_KELURAHAN, S.KD_KLS_BNG, TO_CHAR(S.TGL_JATUH_TEMPO_SPPT,'DD-MM-YYYY') AS TGL_JATUH_TEMPO_SPPT,
CASE WHEN (S.PBB_YG_HARUS_DIBAYAR_SPPT-PS.JML_SPPT_YG_DIBAYAR) < 0 THEN 0 ELSE (S.PBB_YG_HARUS_DIBAYAR_SPPT-PS.JML_SPPT_YG_DIBAYAR) END AS PBB_BELUM_BAYAR, DT.NM_DATI2, S.KD_KLS_TANAH
 FROM SPPT S
JOIN PEMBAYARAN_SPPT PS ON (S.THN_PAJAK_SPPT=PS.THN_PAJAK_SPPT AND S.KD_KECAMATAN=PS.KD_KECAMATAN AND S.KD_KELURAHAN =PS.KD_KELURAHAN AND S.KD_BLOK = PS.KD_BLOK AND S.NO_URUT=PS.NO_URUT AND S.KD_JNS_OP=PS.KD_JNS_OP)
JOIN DAT_OBJEK_PAJAK OP ON (S.KD_PROPINSI=OP.KD_PROPINSI AND S.KD_DATI2=OP.KD_DATI2 AND S.KD_KECAMATAN=OP.KD_KECAMATAN AND S.KD_KELURAHAN =OP.KD_KELURAHAN AND S.KD_BLOK = OP.KD_BLOK AND S.NO_URUT=OP.NO_URUT AND S.KD_JNS_OP=OP.KD_JNS_OP)
JOIN REF_KECAMATAN KEC ON (S.KD_PROPINSI=KEC.KD_PROPINSI AND S.KD_DATI2=KEC.KD_DATI2 AND S.KD_KECAMATAN=KEC.KD_KECAMATAN)
JOIN REF_KELURAHAN KEL ON (S.KD_PROPINSI=KEL.KD_PROPINSI AND S.KD_DATI2=KEL.KD_DATI2 AND S.KD_KECAMATAN=KEL.KD_KECAMATAN AND S.KD_KELURAHAN=KEL.KD_KELURAHAN)
LEFT JOIN REF_DATI2 DT ON (S.KD_PROPINSI=DT.KD_PROPINSI AND S.KD_DATI2=DT.KD_DATI2)
WHERE S.KD_PROPINSI = $P{kd_prop} AND S.KD_DATI2=$P{kd_dati2} AND S.KD_KECAMATAN=$P{kd_kecamatan} AND S.KD_KELURAHAN = $P{kd_kelurahan} AND S.KD_BLOK = $P{kd_blok} AND S.NO_URUT=$P{no_urut} AND S.KD_JNS_OP=$P{kd_jns_op} AND CAST(S.THN_PAJAK_SPPT AS NUMBER) < $P!{tahun_sppt} ORDER BY S.THN_PAJAK_SPPT DESC
) BA WHERE ROWNUM <= 6
UNION ALL
SELECT * FROM (

SELECT 'TOTAL' AS NO_BARIS, SUM(PBB_YG_HARUS_DIBAYAR_SPPT) OVER() AS SUM_POKOK_PBB,  SUM(DENDA_SPPT) OVER() AS SUM_DENDA_PBB, SUM(PBB_BELUM_BAYAR) OVER() AS SUM_BLM_BAYAR_PBB,BA.* FROM(
SELECT 'TOTAL' AS THN_PAJAK_SPPT, S.NM_WP_SPPT, S.JLN_WP_SPPT, S.BLOK_KAV_NO_WP_SPPT, S.RW_WP_SPPT, S.RT_WP_SPPT, S.KELURAHAN_WP_SPPT, S.KOTA_WP_SPPT,S.LUAS_BUMI_SPPT, S.NJOP_BUMI_SPPT, S.LUAS_BNG_SPPT, S.NJOP_BNG_SPPT,S.NJOP_SPPT,
S.NJOPTKP_SPPT, S.TARIF_SPPT, S.PBB_TERHUTANG_SPPT, S.FAKTOR_PENGURANG_SPPT, S.PBB_YG_HARUS_DIBAYAR_SPPT, PS.DENDA_SPPT,
PS.JML_SPPT_YG_DIBAYAR, PS.THN_PAJAK_SPPT AS THN_BAYAR_SPPT, TO_CHAR(S.TGL_CETAK_SPPT,'DD-MM-YYYY') AS TGL_CETAK_SPPT, (S.KD_PROPINSI||S.KD_DATI2||S.KD_KECAMATAN||S.KD_KELURAHAN||S.KD_BLOK||S.NO_URUT||S.KD_JNS_OP) AS NOP, OP.JALAN_OP
, OP.RW_OP, OP.RT_OP, KEC.NM_KECAMATAN, KEL.NM_KELURAHAN, S.KD_KLS_BNG, TO_CHAR(S.TGL_JATUH_TEMPO_SPPT,'DD-MM-YYYY') AS TGL_JATUH_TEMPO_SPPT,
CASE WHEN (S.PBB_YG_HARUS_DIBAYAR_SPPT-PS.JML_SPPT_YG_DIBAYAR) < 0 THEN 0 ELSE (S.PBB_YG_HARUS_DIBAYAR_SPPT-PS.JML_SPPT_YG_DIBAYAR) END AS PBB_BELUM_BAYAR, DT.NM_DATI2, S.KD_KLS_TANAH
 FROM SPPT S
JOIN PEMBAYARAN_SPPT PS ON (S.THN_PAJAK_SPPT=PS.THN_PAJAK_SPPT AND S.KD_KECAMATAN=PS.KD_KECAMATAN AND S.KD_KELURAHAN =PS.KD_KELURAHAN AND S.KD_BLOK = PS.KD_BLOK AND S.NO_URUT=PS.NO_URUT AND S.KD_JNS_OP=PS.KD_JNS_OP)
JOIN DAT_OBJEK_PAJAK OP ON (S.KD_PROPINSI=OP.KD_PROPINSI AND S.KD_DATI2=OP.KD_DATI2 AND S.KD_KECAMATAN=OP.KD_KECAMATAN AND S.KD_KELURAHAN =OP.KD_KELURAHAN AND S.KD_BLOK = OP.KD_BLOK AND S.NO_URUT=OP.NO_URUT AND S.KD_JNS_OP=OP.KD_JNS_OP)
JOIN REF_KECAMATAN KEC ON (S.KD_PROPINSI=KEC.KD_PROPINSI AND S.KD_DATI2=KEC.KD_DATI2 AND S.KD_KECAMATAN=KEC.KD_KECAMATAN)
JOIN REF_KELURAHAN KEL ON (S.KD_PROPINSI=KEL.KD_PROPINSI AND S.KD_DATI2=KEL.KD_DATI2 AND S.KD_KECAMATAN=KEL.KD_KECAMATAN AND S.KD_KELURAHAN=KEL.KD_KELURAHAN)
LEFT JOIN REF_DATI2 DT ON (S.KD_PROPINSI=DT.KD_PROPINSI AND S.KD_DATI2=DT.KD_DATI2)
WHERE S.KD_PROPINSI = $P{kd_prop} AND S.KD_DATI2=$P{kd_dati2} AND S.KD_KECAMATAN=$P{kd_kecamatan} AND S.KD_KELURAHAN = $P{kd_kelurahan} AND S.KD_BLOK = $P{kd_blok} AND S.NO_URUT=$P{no_urut} AND S.KD_JNS_OP=$P{kd_jns_op} AND CAST(S.THN_PAJAK_SPPT AS NUMBER) < $P!{tahun_sppt} ORDER BY S.THN_PAJAK_SPPT DESC
) BA WHERE ROWNUM <= 6
)WHERE ROWNUM <= 1]]>
	</queryString>
	<field name="NO_BARIS" class="java.lang.String"/>
	<field name="SUM_POKOK_PBB" class="java.math.BigDecimal"/>
	<field name="SUM_DENDA_PBB" class="java.math.BigDecimal"/>
	<field name="SUM_BLM_BAYAR_PBB" class="java.math.BigDecimal"/>
	<field name="THN_PAJAK_SPPT" class="java.lang.String"/>
	<field name="NM_WP_SPPT" class="java.lang.String"/>
	<field name="JLN_WP_SPPT" class="java.lang.String"/>
	<field name="BLOK_KAV_NO_WP_SPPT" class="java.lang.String"/>
	<field name="RW_WP_SPPT" class="java.lang.String"/>
