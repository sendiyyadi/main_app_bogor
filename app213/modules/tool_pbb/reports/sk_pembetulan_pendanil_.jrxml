<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sk_pembetulan_01" language="groovy" pageWidth="595" pageHeight="842" columnWidth="525" leftMargin="35" rightMargin="35" topMargin="35" bottomMargin="35" uuid="b03552f2-7522-4447-80fd-b2785b7cfc54">
	<property name="ireport.zoom" value="1.5000000000000027"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="1890"/>
	<parameter name="logo_bogor" class="java.lang.String"/>
	<parameter name="id_ppo" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
                SP.NM_WP, P.THN_PAJAK_PERMOHONAN, P.THN_PELAYANAN||'.'||P.BUNDEL_PELAYANAN||'.'||P.NO_URUT_PELAYANAN AS NOPEL,
                OP.KD_PROPINSI||'.'||OP.KD_DATI2||'.'||OP.KD_KECAMATAN||'.'||OP.KD_KELURAHAN||'.'||OP.KD_BLOK||'.'||OP.NO_URUT||'.'||OP.KD_JNS_OP AS NOP,
                TO_CHAR(OP.TOTAL_LUAS_BUMI, 'FM999G999G999G999G999G999G999G999') AS TOTAL_LUAS_BUMI,
                TO_CHAR(OP.TOTAL_LUAS_BNG, 'FM999G999G999G999G999G999G999G999') AS TOTAL_LUAS_BNG,
                TO_CHAR(OP.NJOP_BUMI, 'FM999G999G999G999G999G999G999G999') AS NJOP_BUMI,
                TO_CHAR(OP.NJOP_BNG, 'FM999G999G999G999G999G999G999G999') AS NJOP_BNG,
                CASE WHEN OP.TOTAL_LUAS_BUMI > 0
                    THEN TO_CHAR((OP.NJOP_BUMI/OP.TOTAL_LUAS_BUMI), 'FM999G999G999G999G999G999G999G999') ELSE '0' END AS NJOP_BUMI_PERM,
                CASE WHEN OP.TOTAL_LUAS_BNG > 0
                    THEN TO_CHAR((OP.NJOP_BNG/OP.TOTAL_LUAS_BNG), 'FM999G999G999G999G999G999G999G999') ELSE '0' END AS NJOP_BNG_PERM,
                INITCAP(FMT_TGL_TEKS(P.TGL_VER_PDL)) AS TGL_VER_PDL,
                INITCAP(SP.JALAN_WP)||' '||SP.BLOK_KAV_NO_WP||' RT. '||NVL(SP.RT_WP,'-')||' RW. '||NVL(SP.RW_WP,'-')||' Kel. '
                ||INITCAP(SP.KELURAHAN_WP)||' Kota '||INITCAP(SP.KOTA_WP) as ALAMAT_WP,
                TRIM(INITCAP(OP.JALAN_OP)||' '||OP.BLOK_KAV_NO_OP||' RT. '||NVL(OP.RT_OP,'-')||' RW. '||NVL(OP.RW_OP,'-')) as ALAMAT_OP,
                INITCAP(KL.NM_KELURAHAN) AS KEL_OP, INITCAP(KC.NM_KECAMATAN) AS KEC_OP, OBM.KD_ZNT,
                INITCAP(RJ.NM_SUB_JENIS_PELAYANAN) AS NM_SUB_JENIS_PELAYANAN,
                TO_CHAR(OPH.TOTAL_LUAS_BUMI, 'FM999G999G999G999G999G999G999G999') AS TOTAL_LUAS_BUMI_SBLM,
                TO_CHAR(OPH.TOTAL_LUAS_BNG, 'FM999G999G999G999G999G999G999G999') AS TOTAL_LUAS_BNG_SBLM,
                CASE WHEN OPH.TOTAL_LUAS_BNG > 0
                    THEN TO_CHAR((OPH.NJOP_BNG / OPH.TOTAL_LUAS_BNG), 'FM999G999G999G999G999G999G999G999') ELSE '0' END AS NJOP_BNG_PERM_SBLM,
                CASE WHEN OPH.TOTAL_LUAS_BUMI > 0
                    THEN TO_CHAR((OPH.NJOP_BUMI / OPH.TOTAL_LUAS_BUMI), 'FM999G999G999G999G999G999G999G999') ELSE '0' END AS NJOP_BUMI_PERM_SBLM,
                OBMH.KD_ZNT AS KD_ZNT_SBLM,
                NVL(P.PENGGUNAAN_BNG_PDL,' ') AS PENGGUNAAN_BNG_PDL, 
                NVL(P.OBJEK_BNG_PDL,' ') AS OBJEK_BNG_PDL, 
                NVL(P.DASAR_PENILAIAN,' ') AS DASAR_PENILAIAN, 
                NVL(P.KET_BUMI_PDL,' ') AS KET_BUMI_PDL, 
                NVL(P.KET_BNG_PDL,' ') AS KET_BNG_PDL,
                VER_P.NAMA AS NAMA_VERIF, TRIM(VER_P.NIP) AS NIP_VERIF,
                SUBID_P.NAMA AS NAMA_SUBID, NVL(TRIM(SUBID_P.NIP),'') AS NIP_SUBID,
                KABID_P.NAMA AS NAMA_KABID, NVL(TRIM(KABID_P.NIP),'') AS NIP_KABID,
                SPH.NM_WP AS NM_WP_SBLM,
                INITCAP(SPH.JALAN_WP)||' '||SPH.BLOK_KAV_NO_WP||' RT. '||NVL(SPH.RT_WP,'-')||' RW. '||NVL(SPH.RW_WP,'-')||' Kel. '
                ||INITCAP(SPH.KELURAHAN_WP)||' Kota '||INITCAP(SPH.KOTA_WP) as ALAMAT_WP_SBLM,
                TRIM(INITCAP(OPH.JALAN_OP)||' '||OPH.BLOK_KAV_NO_OP||' RT. '||NVL(OPH.RT_OP,'-')||' RW. '||NVL(OPH.RW_OP,'-')) as ALAMAT_OP_SBLM,
                INITCAP(KLH.NM_KELURAHAN) AS KEL_OP_SBLM, INITCAP(KCH.NM_KECAMATAN) AS KEC_OP_SBLM
                FROM PST_PERMOHONAN_TOOL P
                JOIN DAT_OBJEK_PAJAK_ONLINE OP ON P.ID = OP.DOCH_ID
                JOIN DAT_SUBJEK_PAJAK_ONLINE SP ON P.ID = SP.DOCH_ID
                JOIN DAT_OP_BUMI_ONLINE OBM ON P.ID = OBM.DOCH_ID
                JOIN REF_SUB_JNS_PELAYANAN RJ ON P.KD_JNS_PELAYANAN = RJ.KD_JNS_PELAYANAN AND P.KD_SUB_JNS_PELAYANAN = RJ.KD_SUB_JNS_PELAYANAN
                JOIN REF_KECAMATAN KC ON KC.KD_KECAMATAN = OP.KD_KECAMATAN
                JOIN REF_KELURAHAN KL ON KL.KD_KECAMATAN = OP.KD_KECAMATAN AND KL.KD_KELURAHAN = OP.KD_KELURAHAN
                JOIN DAT_OBJEK_PAJAK OPH ON OPH.KD_PROPINSI = OP.KD_PROPINSI AND OPH.KD_DATI2 = OP.KD_DATI2 AND OPH.KD_KECAMATAN = OP.KD_KECAMATAN
                    AND OPH.KD_KELURAHAN = OP.KD_KELURAHAN AND OPH.KD_BLOK = OP.KD_BLOK AND OPH.NO_URUT = OP.NO_URUT AND OPH.KD_JNS_OP = OP.KD_JNS_OP
                JOIN DAT_SUBJEK_PAJAK SPH ON TRIM(SPH.SUBJEK_PAJAK_ID) = TRIM (OPH.SUBJEK_PAJAK_ID)
                JOIN DAT_OP_BUMI OBMH ON OBMH.KD_PROPINSI = OP.KD_PROPINSI AND OBMH.KD_DATI2 = OP.KD_DATI2 AND OBMH.KD_KECAMATAN = OP.KD_KECAMATAN
                    AND OBMH.KD_KELURAHAN = OP.KD_KELURAHAN AND OBMH.KD_BLOK = OP.KD_BLOK AND OBMH.NO_URUT = OP.NO_URUT AND OBMH.KD_JNS_OP = OP.KD_JNS_OP
                JOIN REF_KECAMATAN KCH ON KCH.KD_KECAMATAN = OPH.KD_KECAMATAN
                JOIN REF_KELURAHAN KLH ON KLH.KD_KECAMATAN = OPH.KD_KECAMATAN AND KLH.KD_KELURAHAN = OPH.KD_KELURAHAN
                JOIN SEC_USERS VER_P ON TRIM(VER_P.NIP) = TRIM(P.NIP_VER_PDL)
                LEFT JOIN SEC_USERS SUBID_P ON TRIM(SUBID_P.NIP) = TRIM(P.NIP_SUBID_PDL)
                LEFT JOIN SEC_USERS KABID_P ON TRIM(KABID_P.NIP) = TRIM(P.NIP_BID_PDL)
                WHERE P.ID = $P{id_ppo}]]>
	</queryString>
