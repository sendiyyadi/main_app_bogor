	<field name="KEL_OP" class="java.lang.String"/>
	<field name="KEC_OP" class="java.lang.String"/>
	<field name="ALAMAT_WP_SBLM" class="java.lang.String"/>
	<field name="ALAMAT_OP_SBLM" class="java.lang.String"/>
