	<field name="KEC_OP_SBLM" class="java.lang.String"/>
	<field name="KD_ZNT" class="java.lang.String"/>
	<field name="KD_ZNT_SBLM" class="java.lang.String"/>
	<field name="NM_SUB_JENIS_PELAYANAN" class="java.lang.String"/>
