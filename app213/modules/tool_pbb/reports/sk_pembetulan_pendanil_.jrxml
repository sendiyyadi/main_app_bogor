			<staticText>
				<reportElement x="40" y="333" width="485" height="55" uuid="784f9756-60de-4d37-94e9-84dc3592434c"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[NJOP Bumi yang memiliki ciri spesifik baik bumi/tanah kosong maupun yang dikembangkan/dibangun memiliki kelemahan dan keunggulan dari berbagai aspek antara lain legal, fisik dan ekonomi, sehingga perlu dilaksanakan analisa penyempurnaan ZNT dan NIRnya, beberapa ciri spesifik dapat ditinjau antara lain dari faktor sebagai berikut :]]></text>
			</staticText>
			<staticText>
				<reportElement x="40" y="388" width="16" height="15" uuid="48015d0c-8407-4cb7-9477-7e222208c45f"/>
				<textElement verticalAlignment="Top">
					<font size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[a.]]></text>
			</staticText>
			<staticText>
				<reportElement x="56" y="388" width="469" height="30" uuid="7df65e38-1ed0-499c-94a8-b4c5907d2c86"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[Bentuk lahan memberikan kontribusi nilai karena faktor keunggulan dan kelemahan dari segi kemudahan untuk optimalitas pengembangan/pembangunannya, view, aksesbilitas / kedekatan dengan jalan, yaitu]]></text>
			</staticText>
			<staticText>
				<reportElement x="72" y="418" width="453" height="30" uuid="a9f83dfa-a1a8-491f-a71c-87faf22212f7"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[Memiliki bentuk beraturan dengan ukuran panjang jauh lebih besar daripada ukuran lebarnya atau ukuran panjang bidang jauh lebih panjang dibandingkan rata-rata panjang bidang lain di sekitarnya]]></text>
			</staticText>
			<staticText>
				<reportElement x="56" y="418" width="16" height="15" uuid="47f1b834-1b74-4f59-90a6-d75f4b005351"/>
				<textElement verticalAlignment="Top">
					<font size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[i.]]></text>
			</staticText>
			<staticText>
				<reportElement x="72" y="448" width="453" height="30" uuid="005ed3af-7f63-4d63-a34b-1927e3e57fd9"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[Memiliki bentuk tidak beraturan dibandingkan rata-rata bentuk bidang yang beraturan pada umumnya]]></text>
			</staticText>
			<staticText>
				<reportElement x="56" y="448" width="16" height="15" uuid="ee29ca88-ba44-4494-8d0e-202913c91ec5"/>
