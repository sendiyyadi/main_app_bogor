				<textElement textAlignment="Justified">
					<font fontName="SansSerif" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["bahwa Wajib Pajak atas nama "+$F{NAMA_PEMOHON}+
" mengajukan permohonan pembetulan Surat Pemberitahuan Pajak Terhutang Pajak Bumi dan Bangunan Perdesaan dan Perkotaan berdasarkan nomor pelayanan "
+$F{NOPEL}+" pada tanggal "+
$F{TGL_TERIMA_DOKUMEN}+";"]]></textFieldExpression>
			</textField>
			<staticText>
