				<reportElement x="105" y="435" width="440" height="72" uuid="bea3b86b-1217-471e-9da1-4efba18da881"/>
				<textElement textAlignment="Justified">
					<font fontName="SansSerif" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["bahwa berdasarkan pertimbangan sebagaimana dimaksud dalam huruf a, huruf b, dan huruf c, perlu menetapkan Keputusan Kepala Badan Pengelolaan Pendapatan Daerah tentang Pembetulan Surat Pemberitahuan Pajak Terhutang Pajak Bumi dan Bangunan Perdesaan dan Perkotaan atas Nomor Objek Pajak "
+$F{NOP}]]></textFieldExpression>
			</textField>
