<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sk_pembetulan_01" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b03552f2-7522-4447-80fd-b2785b7cfc54">
	<property name="ireport.zoom" value="1.5000000000000016"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="3206"/>
	<parameter name="logo_bogor" class="java.lang.String"/>
	<parameter name="bg" class="java.lang.String"/>
	<parameter name="id_ppo" class="java.lang.String"/>
	<queryString>
		<![CDATA[WITH HD AS (
                  SELECT INITCAP(FMT_TGL_TEKS(P.TGL_SURAT_PERMOHONAN)) AS TGL_SURAT_PERMOHONAN,
			      INITCAP(FMT_TGL_TEKS(P.TGL_TERIMA_DOKUMEN_WP)) AS TGL_TERIMA_DOKUMEN,
			      P.THN_PELAYANAN||'-'||P.BUNDEL_PELAYANAN||'-'||P.NO_URUT_PELAYANAN AS NOPEL, NVL(P.NO_SRT_PERMOHONAN,'-') AS NO_SRT_PERMOHONAN,
			      INITCAP(P.NAMA_PEMOHON) AS NAMA_PEMOHON, INITCAP(P.ALAMAT_PEMOHON) AS ALAMAT_PEMOHON,
			      OP.KD_PROPINSI||'.'||OP.KD_DATI2||'.'||OP.KD_KECAMATAN||'.'||OP.KD_KELURAHAN||'.'||OP.KD_BLOK||'.'||OP.NO_URUT||'.'||OP.KD_JNS_OP AS NOP,
			      INITCAP(SP.NM_WP) AS NM_WP, INITCAP(OP.JALAN_OP)||' '||OP.BLOK_KAV_NO_OP||' RT. '||NVL(OP.RT_OP,'-')||' RW. '||NVL(OP.RW_OP,'-')||' Desa '||
			      INITCAP(KL.NM_KELURAHAN)||' Kecamatan '||INITCAP(KC.NM_KECAMATAN)||' Kabupaten Bogor.' as ALAMAT_OP,
			      0 AS KETETAPAN, OP.NJOP_BUMI, OP.NJOP_BNG,
			      P.THN_PAJAK_PERMOHONAN as THN_PAJAK_SPPT, KC.NM_KECAMATAN, NVL(P.KET_VERLAP, ' ') KET_VERLAP, NVL(P.REKOM_VERLAP, ' ') REKOM_VERLAP,
			      INITCAP(FMT_TGL_TEKS(P.TGL_SK)) AS TGL_SK, P.NO_SK,
			      INITCAP(FMT_TGL_TEKS(P.TGL_BAP_LAPANGAN)) AS TGL_BAP_LAPANGAN, P.NO_BAP_LAPANGAN,
			      NVL(P.PROSES_PK, ' ') PROSES_PK, NVL(P.ANALISA_PK, ' ') ANALISA_PK, NVL(P.KETERANGAN_PK, ' ') KETERANGAN_PK,
			      NVL(P.PROSES_PL, ' ') PROSES_PL, NVL(P.ANALISA_PL, ' ') ANALISA_PL, NVL(P.KETERANGAN_PL, ' ') KETERANGAN_PL,
			      OP.TOTAL_LUAS_BUMI, OP.TOTAL_LUAS_BNG,
			      CASE WHEN OP.TOTAL_LUAS_BNG > 0 THEN OP.NJOP_BNG / OP.TOTAL_LUAS_BNG ELSE 0 END AS NJOP_BNG_PERM,
			      CASE WHEN OP.TOTAL_LUAS_BUMI > 0 THEN OP.NJOP_BUMI / OP.TOTAL_LUAS_BUMI ELSE 0 END AS NJOP_BUMI_PERM,
			      OPH.TOTAL_LUAS_BUMI AS TOTAL_LUAS_BUMI_SBLM, OPH.TOTAL_LUAS_BNG AS TOTAL_LUAS_BNG_SBLM,
			      CASE WHEN OPH.TOTAL_LUAS_BNG > 0 THEN OPH.NJOP_BNG / OPH.TOTAL_LUAS_BNG ELSE 0 END AS NJOP_BNG_PERM_SBLM,
			      CASE WHEN OPH.TOTAL_LUAS_BUMI > 0 THEN OPH.NJOP_BUMI / OPH.TOTAL_LUAS_BUMI ELSE 0 END AS NJOP_BUMI_PERM_SBLM,
			      SPH.PBB_YG_HARUS_DIBAYAR_SPPT AS KETETAPAN_SBLM,
			      SPH.NJOP_BUMI_SPPT AS NJOP_BUMI_SBLM, SPH.NJOP_BNG_SPPT AS NJOP_BNG_SBLM,
			      INITCAP(TRIM(SPH.NM_WP_SPPT)) AS NM_WP_SBLM,
			      INITCAP(TRIM(SP.JALAN_WP))||' '||TRIM(SP.BLOK_KAV_NO_WP)||' RT. '||NVL(TRIM(SP.RT_WP),'-')||' RW. '||
			      NVL(TRIM(SP.RW_WP),'-')||', '||INITCAP(NVL(TRIM(SP.KELURAHAN_WP),'-'))||', '||
			      INITCAP(NVL(TRIM(SP.KOTA_WP),'-')) AS ALAMAT_WP,
			      INITCAP(TRIM(SPH.JLN_WP_SPPT))||' '||TRIM(SPH.BLOK_KAV_NO_WP_SPPT)||' RT. '||NVL(TRIM(SPH.RT_WP_SPPT),'-')||' RW. '||
			      NVL(TRIM(SPH.RW_WP_SPPT),'-')||', '||INITCAP(NVL(TRIM(SPH.KELURAHAN_WP_SPPT),'-'))||', '||
			      INITCAP(NVL(TRIM(SPH.KOTA_WP_SPPT),'-')) AS ALAMAT_WP_SBLM,
			      INITCAP(TRIM(OPH.JALAN_OP))||' '||TRIM(OPH.BLOK_KAV_NO_OP)||' RT. '||NVL(TRIM(OPH.RT_OP),'-')||' RW. '||NVL(TRIM(OPH.RW_OP),'-')||
			      ' Desa '||INITCAP(KLH.NM_KELURAHAN)||' Kecamatan '||INITCAP(KCH.NM_KECAMATAN)||' Kabupaten Bogor.' as ALAMAT_OP_SBLM,
			      INITCAP(FMT_TGL_TEKS(SYSDATE)) AS JTH_TEMPO,
			      INITCAP(FMT_TGL_TEKS(SPH.TGL_JATUH_TEMPO_SPPT)) AS JTH_TEMPO_SBLM,
			      RS.KET AS KET_SYARAT, NVL(PD.KETERANGAN, ' ') KETERANGAN, PD.STATUS, RS.ID AS ID_SYARAT
			      FROM PST_PERMOHONAN_TOOL P
			      CROSS JOIN REF_SYARAT_PENELITI RS
			      LEFT JOIN PST_TOOL_DTL_PNLT PD ON P.ID = PD.ID_PPO AND RS.ID = PD.ID_REF_SYARAT
			      JOIN DAT_OBJEK_PAJAK_ONLINE OP ON P.ID = OP.DOCH_ID
			      JOIN DAT_SUBJEK_PAJAK_ONLINE SP ON P.ID = SP.DOCH_ID
			      JOIN REF_KECAMATAN KC ON KC.KD_KECAMATAN = OP.KD_KECAMATAN
			      JOIN REF_KELURAHAN KL ON KL.KD_KECAMATAN = OP.KD_KECAMATAN AND KL.KD_KELURAHAN = OP.KD_KELURAHAN
			      JOIN DAT_OBJEK_PAJAK OPH ON P.KD_PROPINSI_PEMOHON = OPH.KD_PROPINSI AND P.KD_DATI2_PEMOHON = OPH.KD_DATI2
			        AND P.KD_KECAMATAN_PEMOHON = OPH.KD_KECAMATAN AND P.KD_KELURAHAN_PEMOHON = OPH.KD_KELURAHAN
			        AND P.KD_BLOK_PEMOHON = OPH.KD_BLOK AND P.NO_URUT_PEMOHON = OPH.NO_URUT AND P.KD_JNS_OP_PEMOHON = OPH.KD_JNS_OP
			      JOIN SPPT SPH ON P.KD_PROPINSI_PEMOHON = SPH.KD_PROPINSI AND P.KD_DATI2_PEMOHON = SPH.KD_DATI2
			        AND P.KD_KECAMATAN_PEMOHON = SPH.KD_KECAMATAN AND P.KD_KELURAHAN_PEMOHON = SPH.KD_KELURAHAN
			        AND P.KD_BLOK_PEMOHON = SPH.KD_BLOK AND P.NO_URUT_PEMOHON = SPH.NO_URUT AND P.KD_JNS_OP_PEMOHON = SPH.KD_JNS_OP
			        AND P.THN_PAJAK_PERMOHONAN = SPH.THN_PAJAK_SPPT
			      JOIN REF_KECAMATAN KCH ON KCH.KD_KECAMATAN = OPH.KD_KECAMATAN
			      JOIN REF_KELURAHAN KLH ON KLH.KD_KECAMATAN = OPH.KD_KECAMATAN AND KLH.KD_KELURAHAN = OPH.KD_KELURAHAN
			      WHERE P.ID = $P{id_ppo}
                )
                SELECT TGL_SURAT_PERMOHONAN, TGL_TERIMA_DOKUMEN, NOPEL, NO_SRT_PERMOHONAN, NAMA_PEMOHON,
                ALAMAT_PEMOHON, NOP, NM_WP, ALAMAT_OP, TO_CHAR(KETETAPAN, 'FM999G999G999G999G999G999G999G999') AS KETETAPAN,
                TO_CHAR(NJOP_BUMI, 'FM999G999G999G999G999G999G999G999') AS NJOP_BUMI,
                TO_CHAR(NJOP_BNG, 'FM999G999G999G999G999G999G999G999') AS NJOP_BNG,
                THN_PAJAK_SPPT, TGL_BAP_LAPANGAN, NO_BAP_LAPANGAN, KET_VERLAP, REKOM_VERLAP, TGL_SK, NO_SK,
                PROSES_PK, ANALISA_PK, KETERANGAN_PK, PROSES_PL, ANALISA_PL, KETERANGAN_PL, NM_KECAMATAN,
                TO_CHAR(TOTAL_LUAS_BUMI, 'FM999G999G999G999G999G999G999G999') AS TOTAL_LUAS_BUMI,
                TO_CHAR(TOTAL_LUAS_BNG, 'FM999G999G999G999G999G999G999G999') AS TOTAL_LUAS_BNG,
                TO_CHAR(NJOP_BUMI_PERM, 'FM999G999G999G999G999G999G999G999') AS NJOP_BUMI_PERM,
                TO_CHAR(NJOP_BNG_PERM, 'FM999G999G999G999G999G999G999G999') AS NJOP_BNG_PERM,
                TO_CHAR(TOTAL_LUAS_BUMI_SBLM, 'FM999G999G999G999G999G999G999G999') AS TOTAL_LUAS_BUMI_SBLM,
                TO_CHAR(TOTAL_LUAS_BNG_SBLM, 'FM999G999G999G999G999G999G999G999') AS TOTAL_LUAS_BNG_SBLM,
                TO_CHAR(NJOP_BUMI_PERM_SBLM, 'FM999G999G999G999G999G999G999G999') AS NJOP_BUMI_PERM_SBLM,
                TO_CHAR(NJOP_BNG_PERM_SBLM, 'FM999G999G999G999G999G999G999G999') AS NJOP_BNG_PERM_SBLM,
                NM_WP_SBLM, ALAMAT_OP_SBLM, ALAMAT_WP, ALAMAT_WP_SBLM, JTH_TEMPO, JTH_TEMPO_SBLM,
                TO_CHAR(KETETAPAN_SBLM, 'FM999G999G999G999G999G999G999G999') AS KETETAPAN_SBLM,
                TO_CHAR(NJOP_BUMI_SBLM, 'FM999G999G999G999G999G999G999G999') AS NJOP_BUMI_SBLM,
                TO_CHAR(NJOP_BNG_SBLM, 'FM999G999G999G999G999G999G999G999') AS NJOP_BNG_SBLM,
                MAX(CASE WHEN ID_SYARAT = 1 THEN KET_SYARAT END) AS KET_SYARAT_1,
                MAX(CASE WHEN ID_SYARAT = 1 THEN STATUS END)     AS STATUS_1,
                MAX(CASE WHEN ID_SYARAT = 1 THEN KETERANGAN END) AS KETERANGAN_1,
                MAX(CASE WHEN ID_SYARAT = 2 THEN KET_SYARAT END) AS KET_SYARAT_2,
                MAX(CASE WHEN ID_SYARAT = 2 THEN STATUS END)     AS STATUS_2,
                MAX(CASE WHEN ID_SYARAT = 2 THEN KETERANGAN END) AS KETERANGAN_2,
                MAX(CASE WHEN ID_SYARAT = 3 THEN KET_SYARAT END) AS KET_SYARAT_3,
                MAX(CASE WHEN ID_SYARAT = 3 THEN STATUS END)     AS STATUS_3,
                MAX(CASE WHEN ID_SYARAT = 3 THEN KETERANGAN END) AS KETERANGAN_3,
                MAX(CASE WHEN ID_SYARAT = 4 THEN KET_SYARAT END) AS KET_SYARAT_4,
                MAX(CASE WHEN ID_SYARAT = 4 THEN STATUS END)     AS STATUS_4,
                MAX(CASE WHEN ID_SYARAT = 4 THEN KETERANGAN END) AS KETERANGAN_4,
                MAX(CASE WHEN ID_SYARAT = 5 THEN KET_SYARAT END) AS KET_SYARAT_5,
                MAX(CASE WHEN ID_SYARAT = 5 THEN STATUS END)     AS STATUS_5,
                MAX(CASE WHEN ID_SYARAT = 5 THEN KETERANGAN END) AS KETERANGAN_5,
                MAX(CASE WHEN ID_SYARAT = 6 THEN KET_SYARAT END) AS KET_SYARAT_6,
                MAX(CASE WHEN ID_SYARAT = 6 THEN STATUS END)     AS STATUS_6,
                MAX(CASE WHEN ID_SYARAT = 6 THEN KETERANGAN END) AS KETERANGAN_6,
                MAX(CASE WHEN ID_SYARAT = 7 THEN KET_SYARAT END) AS KET_SYARAT_7,
                MAX(CASE WHEN ID_SYARAT = 7 THEN STATUS END)     AS STATUS_7,
                MAX(CASE WHEN ID_SYARAT = 7 THEN KETERANGAN END) AS KETERANGAN_7,
                MAX(CASE WHEN ID_SYARAT = 8 THEN KET_SYARAT END) AS KET_SYARAT_8,
                MAX(CASE WHEN ID_SYARAT = 8 THEN STATUS END)     AS STATUS_8,
                MAX(CASE WHEN ID_SYARAT = 8 THEN KETERANGAN END) AS KETERANGAN_8
                FROM HD
                GROUP BY TGL_SURAT_PERMOHONAN, TGL_TERIMA_DOKUMEN, NOPEL, NO_SRT_PERMOHONAN, NAMA_PEMOHON, KET_VERLAP, REKOM_VERLAP,
                ALAMAT_PEMOHON, NOP, NM_WP, ALAMAT_OP, KETETAPAN, THN_PAJAK_SPPT, TGL_BAP_LAPANGAN, NO_BAP_LAPANGAN,  TGL_SK, NO_SK,
                PROSES_PK, ANALISA_PK, KETERANGAN_PK, PROSES_PL, ANALISA_PL, KETERANGAN_PL, NM_KECAMATAN,
                TOTAL_LUAS_BUMI, TOTAL_LUAS_BNG, NJOP_BUMI_PERM, NJOP_BNG_PERM,
                TOTAL_LUAS_BUMI_SBLM, TOTAL_LUAS_BNG_SBLM, NJOP_BUMI_PERM_SBLM, NJOP_BNG_PERM_SBLM,
                KETETAPAN_SBLM, NJOP_BUMI_SBLM, NJOP_BNG_SBLM, NJOP_BUMI, NJOP_BNG,
                NM_WP_SBLM, ALAMAT_OP_SBLM, ALAMAT_WP, ALAMAT_WP_SBLM, JTH_TEMPO, JTH_TEMPO_SBLM]]>
	</queryString>
	<field name="TGL_SURAT_PERMOHONAN" class="java.lang.String"/>
	<field name="TGL_TERIMA_DOKUMEN" class="java.lang.String"/>
	<field name="NOPEL" class="java.lang.String"/>
	<field name="NO_SRT_PERMOHONAN" class="java.lang.String"/>
	<field name="NAMA_PEMOHON" class="java.lang.String"/>
