					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[LEMBAR PENELITIAN PERSYARATAN PENGAJUAN PEMBETULAN PADA SURAT PEMBERITAHUAN PAJAK TERHUTANG (SPPT) PAJAK BUMI DAN BANGUNAN PERDESAAN DAN PERKOTAAN (PBB P2)]]></text>
