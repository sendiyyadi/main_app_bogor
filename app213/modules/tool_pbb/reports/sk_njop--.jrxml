<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sk_njop" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b03552f2-7522-4447-80fd-b2785b7cfc54">
	<property name="ireport.zoom" value="1.6105100000000279"/>
	<property name="ireport.x" value="100"/>
	<property name="ireport.y" value="619"/>
	<parameter name="logo_bogor" class="java.lang.String"/>
	<parameter name="bambang" class="java.lang.String"/>
	<parameter name="kd_prop" class="java.lang.String"/>
	<parameter name="kd_dati2" class="java.lang.String"/>
	<parameter name="kd_kec" class="java.lang.String"/>
	<parameter name="kd_kel" class="java.lang.String"/>
	<parameter name="kd_blok" class="java.lang.String"/>
	<parameter name="no_urut" class="java.lang.String"/>
	<parameter name="kd_jns_op" class="java.lang.String"/>
	<parameter name="tahun" class="java.lang.String"/>
	<parameter name="id_nop" class="java.lang.String"/>
	<queryString>
		<![CDATA[select T.NO_SK,
T.TAHUN AS TAHUN,
O.KD_PROPINSI||O.KD_DATI2||O.KD_KECAMATAN||O.KD_KELURAHAN||O.KD_BLOK||O.NO_URUT||O.KD_JNS_OP AS NOP,
O.JALAN_OP,
KL.NM_KELURAHAN, KC.NM_KECAMATAN,
O.TOTAL_LUAS_BUMI AS LUAS_BUMI,
O.TOTAL_LUAS_BNG AS LUAS_BNG,
O.NJOP_BUMI AS NJOP_BUMI,
O.NJOP_BNG AS NJOP_BNG,
O.NJOP_BUMI+O.NJOP_BNG AS TOTAL,
TERBILANG(O.NJOP_BUMI+O.NJOP_BNG) AS TERBILANG,
S.NM_WP AS NM_WP,
S.JALAN_WP||' Kelurahan '||S.KELURAHAN_WP||'- '||S.KOTA_WP AS ALAMAT_WP
FROM TEMP_SKNJOP_EADM T
JOIN DAT_OBJEK_PAJAK O ON T.KD_PROPINSI = O.KD_PROPINSI
AND T.KD_DATI2 = O.KD_DATI2
AND T.KD_KECAMATAN = O.KD_KECAMATAN
AND T.KD_KELURAHAN = O.KD_KELURAHAN
AND T.KD_BLOK = O.KD_BLOK
AND T.KD_JNS_OP = O.KD_JNS_OP
AND T.NO_URUT = O.NO_URUT
JOIN DAT_SUBJEK_PAJAK S ON O.SUBJEK_PAJAK_ID = S.SUBJEK_PAJAK_ID
JOIN REF_KECAMATAN KC ON O.KD_KECAMATAN = KC.KD_KECAMATAN
JOIN REF_KELURAHAN KL ON O.KD_KECAMATAN = KL.KD_KECAMATAN AND
O.KD_KELURAHAN = KL.KD_KELURAHAN
WHERE T.KD_PROPINSI = $P{kd_prop}
AND T.KD_DATI2 = $P{kd_dati2}
AND T.KD_KECAMATAN = $P{kd_kec}
AND T.KD_KELURAHAN = $P{kd_kel}
AND T.KD_BLOK = $P{kd_blok}
AND T.NO_URUT = $P{no_urut}
AND T.KD_JNS_OP = $P{kd_jns_op}
AND T.TAHUN = $P{tahun}
AND T.ID_NOP = $P{id_nop}]]>
	</queryString>
	<field name="NO_SK" class="java.lang.String"/>
	<field name="NOP" class="java.lang.String"/>
	<field name="JALAN_OP" class="java.lang.String"/>
	<field name="NM_KELURAHAN" class="java.lang.String"/>
	<field name="NM_KECAMATAN" class="java.lang.String"/>
	<field name="LUAS_BUMI" class="java.math.BigDecimal"/>
	<field name="LUAS_BNG" class="java.math.BigDecimal"/>
	<field name="NJOP_BUMI" class="java.math.BigDecimal"/>
	<field name="NJOP_BNG" class="java.math.BigDecimal"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
