			<staticText>
				<reportElement x="49" y="221" width="496" height="38" uuid="6f8df7ff-f5cf-407c-9c6a-44bd396b791f"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[Undang-Undang Nomor 23 Tahun 2014 tentang Pemerintahan Daerah sebagaimana telah beberapa kali diubah, terakhir dengan Undang-Undang Nomor 6 Tahun 2023 tentang Penetapan Peraturan Pemerintah Pengganti Undang-Undang Nomor 2 Tahun 2022 tentang Cipta Kerja menjadi Undang-Undang;]]></text>
			</staticText>
			<staticText>
				<reportElement x="15" y="205" width="19" height="16" uuid="c0baaee5-bc8a-45a8-8e50-a558b4d568a0"/>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[II. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="49" y="259" width="496" height="38" uuid="90ab997f-0e5f-422d-b6b7-01eb41575de1"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[Undang-Undang Nomor 30 Tahun 2014 tentang Administrasi Pemerintahan sebagaimana telah beberapa kali diubah, terakhir dengan Undang-Undang Nomor 6 Tahun 2023 tentang Penetapan Peraturan Pemerintah Pengganti Undang-Undang Nomor 2 Tahun 2022 tentang Cipta Kerja menjadi Undang-Undang;]]></text>
			</staticText>
			<staticText>
				<reportElement x="34" y="259" width="15" height="15" uuid="56d2ed2b-3b52-4e4f-a5f7-88a12d1d67ac"/>
				<textElement verticalAlignment="Top">
