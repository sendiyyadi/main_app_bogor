				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[Peraturan Bupati Bogor Nomor 13 Tahun 2025 tentang Pemberian Pembebasan dan Pengurangan Pokok Serta Sanksi Administratif Pajak Bumi dan Bangunan Perdesaan dan Perkotaan Sampai dengan Tahun Pajak 2025;]]></text>
			</staticText>
