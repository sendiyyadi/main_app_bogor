				<reportElement x="34" y="558" width="15" height="15" uuid="974faca4-8b10-4129-afcd-571f75d3c41f"/>
				<textElement verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[9.]]></text>
