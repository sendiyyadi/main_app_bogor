<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sk_pembetulan_01" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b03552f2-7522-4447-80fd-b2785b7cfc54">
	<property name="ireport.zoom" value="1.4641000000000794"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="4172"/>
	<parameter name="logo_bogor" class="java.lang.String"/>
	<parameter name="id_ppo" class="java.lang.String"/>
	<queryString>
		<![CDATA[WITH HD AS (
                  SELECT INITCAP(FMT_TGL_TEKS(P.TGL_SURAT_PERMOHONAN)) AS TGL_SURAT_PERMOHONAN,
                  INITCAP(FMT_TGL_TEKS(P.TGL_TERIMA_DOKUMEN_WP)) AS TGL_TERIMA_DOKUMEN,
                  P.THN_PELAYANAN||'-'||P.BUNDEL_PELAYANAN||'-'||P.NO_URUT_PELAYANAN AS NOPEL, NVL(P.NO_SRT_PERMOHONAN,'-') AS NO_SRT_PERMOHONAN,
                  INITCAP(P.NAMA_PEMOHON) AS NAMA_PEMOHON, INITCAP(P.ALAMAT_PEMOHON) AS ALAMAT_PEMOHON,
                  OP.KD_PROPINSI||'.'||OP.KD_DATI2||'.'||OP.KD_KECAMATAN||'.'||OP.KD_KELURAHAN||'.'||OP.KD_BLOK||'.'||OP.NO_URUT||'.'||OP.KD_JNS_OP AS NOP,
                  INITCAP(SP.NM_WP) AS NM_WP, INITCAP(OP.JALAN_OP)||' '||OP.BLOK_KAV_NO_OP||' RT. '||NVL(OP.RT_OP,'-')||' RW. '||NVL(OP.RW_OP,'-')||' Desa '||
                  INITCAP(KL.NM_KELURAHAN)||' Kecamatan '||INITCAP(KC.NM_KECAMATAN)||' Kabupaten Bogor.' as ALAMAT_OP,
                  S.PBB_YG_HARUS_DIBAYAR_SPPT AS KETETAPAN, S.FAKTOR_PENGURANG_SPPT AS FAKTOR_PENGURANG,
                  LOWER(TERBILANG(S.PBB_YG_HARUS_DIBAYAR_SPPT)) AS TERBILANG_KETETAPAN,
                  SPH.PBB_YG_HARUS_DIBAYAR_SPPT AS KETETAPAN_AWAL,
                  LOWER(TERBILANG(SPH.PBB_YG_HARUS_DIBAYAR_SPPT)) AS TERBILANG_KETETAPAN_AWAL,
                  S.THN_PAJAK_SPPT, KC.NM_KECAMATAN, NVL(P.KET_VERLAP, ' ') KET_VERLAP, NVL(P.REKOM_VERLAP, ' ') REKOM_VERLAP,
                  INITCAP(FMT_TGL_TEKS(P.TGL_SK)) AS TGL_SK, P.NO_SK,
                  INITCAP(FMT_TGL_TEKS(P.TGL_BAP_LAPANGAN)) AS TGL_BAP_LAPANGAN, P.NO_BAP_LAPANGAN,
                  NVL(P.PROSES_PK, ' ') PROSES_PK, NVL(P.ANALISA_PK, ' ') ANALISA_PK, NVL(P.KETERANGAN_PK, ' ') KETERANGAN_PK,
                  NVL(P.PROSES_PL, ' ') PROSES_PL, NVL(P.ANALISA_PL, ' ') ANALISA_PL, NVL(P.KETERANGAN_PL, ' ') KETERANGAN_PL,
                  INITCAP(TRIM(S.JLN_WP_SPPT))||' '||TRIM(S.BLOK_KAV_NO_WP_SPPT)||' RT. '||NVL(TRIM(S.RT_WP_SPPT),'-')||' RW. '||
                  NVL(TRIM(S.RW_WP_SPPT),'-')||', '||INITCAP(NVL(TRIM(S.KELURAHAN_WP_SPPT),'-'))||', '||
                  INITCAP(NVL(TRIM(S.KOTA_WP_SPPT),'-')) AS ALAMAT_WP,
                  INITCAP(FMT_TGL_TEKS(S.TGL_JATUH_TEMPO_SPPT)) AS JTH_TEMPO,
                  INITCAP(FMT_TGL_TEKS(SPH.TGL_JATUH_TEMPO_SPPT)) AS JTH_TEMPO_AWAL,
                  RS.KET AS KET_SYARAT, NVL(PD.KETERANGAN, ' ') KETERANGAN, PD.STATUS, RS.ID AS ID_SYARAT,
                  P.PCT_PENGURANGAN_APPR as PCT_DISETUJUI,
                  LOWER(TERBILANG(P.PCT_PENGURANGAN_APPR)) AS TX_PCT,
                  CASE WHEN TRIM(P.KD_SUB_JNS_PELAYANAN) = '1' THEN 'Veteran berdasarkan Surat Keterangan dari Desa '||INITCAP(KL.NM_KELURAHAN)||
                  ' Kecamatan '||INITCAP(KC.NM_KECAMATAN)||' menerangkan bahwa Sdr. '||INITCAP(TRIM(S.NM_WP_SPPT))||' merupakan Veteran.'
                  WHEN TRIM(P.KD_SUB_JNS_PELAYANAN) = '2' THEN 'TNI berdasarkan Surat Keterangan dari Desa '||INITCAP(KL.NM_KELURAHAN)||
                  ' Kecamatan '||INITCAP(KC.NM_KECAMATAN)||' menerangkan bahwa Sdr. '||INITCAP(TRIM(S.NM_WP_SPPT))||' merupakan TNI.'
                  WHEN TRIM(P.KD_SUB_JNS_PELAYANAN) = '3' THEN 'POLRI berdasarkan Surat Keterangan dari Desa '||INITCAP(KL.NM_KELURAHAN)||
                  ' Kecamatan '||INITCAP(KC.NM_KECAMATAN)||' menerangkan bahwa Sdr. '||INITCAP(TRIM(S.NM_WP_SPPT))||' merupakan POLRI.'
                  WHEN TRIM(P.KD_SUB_JNS_PELAYANAN) = '4' THEN 'PNS berdasarkan Surat Keterangan dari Desa '||INITCAP(KL.NM_KELURAHAN)||
                  ' Kecamatan '||INITCAP(KC.NM_KECAMATAN)||' menerangkan bahwa Sdr. '||INITCAP(TRIM(S.NM_WP_SPPT))||' merupakan PNS.'
                  WHEN TRIM(P.KD_SUB_JNS_PELAYANAN) = '5' THEN 'warga kurang mampu berdasarkan Surat Keterangan dari Desa '||INITCAP(KL.NM_KELURAHAN)||
                  ' Kecamatan '||INITCAP(KC.NM_KECAMATAN)||' menerangkan bahwa Sdr. '||INITCAP(TRIM(S.NM_WP_SPPT))||' merupakan warga tidak mampu.'
                  WHEN TRIM(P.KD_SUB_JNS_PELAYANAN) = '6' THEN 'Badan Usaha berdasarkan Surat Keterangan dari Desa '||INITCAP(KL.NM_KELURAHAN)||
                  ' Kecamatan '||INITCAP(KC.NM_KECAMATAN)||' menerangkan bahwa Sdr. '||INITCAP(TRIM(S.NM_WP_SPPT))||' merupakan Badan Usaha.'
                  else ''
                  END AS DESC_PENELITIAN_1,
                  CASE WHEN P.STS_PENGURANGAN = '1' THEN 'seluruhnya'
                  WHEN P.STS_PENGURANGAN = '2' THEN 'ditolak'
                  WHEN P.STS_PENGURANGAN = '3' THEN 'sebagian' else '' end as TX_STS_PENGURANGAN,
                  CASE WHEN P.STS_PENGURANGAN = '1' THEN '<b>seluruhnya/<strike>sebagian/menolak/menambah</strike></b>'
                  WHEN P.STS_PENGURANGAN = '2' THEN '<b><strike>seluruhnya/sebagian</strike>/menolak/<strike>menambah</strike></b>'
                  WHEN P.STS_PENGURANGAN = '3' THEN '<b><strike>seluruhnya</strike>/sebagian/<strike>menolak/menambah</strike></b>'
                  else '<b>seluruhnya/sebagian/menolak/menambah</b>' end as KESIMPULAN_BA
                  FROM PST_PERMOHONAN_TOOL P
                  CROSS JOIN REF_SYARAT_PENELITI RS
                  LEFT JOIN PST_TOOL_DTL_PNLT PD ON P.ID = PD.ID_PPO AND RS.ID = PD.ID_REF_SYARAT
                  JOIN DAT_OBJEK_PAJAK OP ON P.KD_PROPINSI_PEMOHON=OP.KD_PROPINSI AND P.KD_DATI2_PEMOHON=OP.KD_DATI2
                    AND P.KD_KECAMATAN_PEMOHON=OP.KD_KECAMATAN AND P.KD_KELURAHAN_PEMOHON=OP.KD_KELURAHAN
                    AND P.KD_BLOK_PEMOHON=OP.KD_BLOK AND P.NO_URUT_PEMOHON=OP.NO_URUT AND P.KD_JNS_OP_PEMOHON=OP.KD_JNS_OP
                  JOIN DAT_SUBJEK_PAJAK SP ON OP.SUBJEK_PAJAK_ID = SP.SUBJEK_PAJAK_ID
                  JOIN REF_KECAMATAN KC ON KC.KD_KECAMATAN = OP.KD_KECAMATAN
                  JOIN REF_KELURAHAN KL ON KL.KD_KECAMATAN = OP.KD_KECAMATAN AND KL.KD_KELURAHAN = OP.KD_KELURAHAN
                  JOIN (
                      SELECT *
                      FROM (
                          SELECT SPH.*,
                                 ROW_NUMBER() OVER (
                                     PARTITION BY SPH.PHIST_ID, SPH.THN_PAJAK_SPPT
                                     ORDER BY SPH.PHIST_ID DESC
                                 ) AS RN
                          FROM PHIST08_SPPT SPH
                      )
                      WHERE RN = 1
                  ) SPH
                      ON P.THN_PELAYANAN||P.BUNDEL_PELAYANAN||P.NO_URUT_PELAYANAN = TRIM(SPH.PHIST_ID)
                      AND SPH.KD_PROPINSI=OP.KD_PROPINSI AND SPH.KD_DATI2=OP.KD_DATI2 AND SPH.KD_KECAMATAN=OP.KD_KECAMATAN
                      AND SPH.KD_KELURAHAN=OP.KD_KELURAHAN AND SPH.KD_BLOK=OP.KD_BLOK AND SPH.NO_URUT=OP.NO_URUT
                      AND SPH.KD_JNS_OP=OP.KD_JNS_OP
                      AND SPH.THN_PAJAK_SPPT = P.THN_PAJAK_PERMOHONAN

                  JOIN SPPT S ON OP.KD_PROPINSI=S.KD_PROPINSI AND OP.KD_DATI2=S.KD_DATI2 AND OP.KD_KECAMATAN=S.KD_KECAMATAN
                        AND OP.KD_KELURAHAN=S.KD_KELURAHAN AND OP.KD_BLOK=S.KD_BLOK AND OP.NO_URUT=S.NO_URUT
                        AND OP.KD_JNS_OP=S.KD_JNS_OP AND S.THN_PAJAK_SPPT = P.THN_PAJAK_PERMOHONAN
                  WHERE P.ID = $P{id_ppo}
                )
                SELECT TGL_SURAT_PERMOHONAN, TGL_TERIMA_DOKUMEN, NOPEL, NO_SRT_PERMOHONAN, NAMA_PEMOHON,
                ALAMAT_PEMOHON, NOP, NM_WP, ALAMAT_OP, ALAMAT_WP,
                THN_PAJAK_SPPT, TGL_BAP_LAPANGAN, NO_BAP_LAPANGAN, KET_VERLAP, REKOM_VERLAP, TGL_SK, NO_SK,
                PROSES_PK, ANALISA_PK, KETERANGAN_PK, PROSES_PL, ANALISA_PL, KETERANGAN_PL, NM_KECAMATAN,
                JTH_TEMPO, JTH_TEMPO_AWAL, TERBILANG_KETETAPAN, TERBILANG_KETETAPAN_AWAL,
                TO_CHAR(KETETAPAN_AWAL, 'FM999G999G999G999G999G999G999G999') AS KETETAPAN_AWAL,
                TO_CHAR(KETETAPAN, 'FM999G999G999G999G999G999G999G999') AS KETETAPAN,
                TO_CHAR(FAKTOR_PENGURANG, 'FM999G999G999G999G999G999G999G999') AS FAKTOR_PENGURANG,
                PCT_DISETUJUI, TX_PCT, TX_STS_PENGURANGAN, KESIMPULAN_BA, DESC_PENELITIAN_1,
                MAX(CASE WHEN ID_SYARAT = 9 THEN KET_SYARAT END) AS KET_SYARAT_1,
                MAX(CASE WHEN ID_SYARAT = 9 THEN STATUS END)     AS STATUS_1,
                MAX(CASE WHEN ID_SYARAT = 9 THEN KETERANGAN END) AS KETERANGAN_1,
                MAX(CASE WHEN ID_SYARAT = 10 THEN KET_SYARAT END) AS KET_SYARAT_2,
                MAX(CASE WHEN ID_SYARAT = 10 THEN STATUS END)     AS STATUS_2,
                MAX(CASE WHEN ID_SYARAT = 10 THEN KETERANGAN END) AS KETERANGAN_2,
                MAX(CASE WHEN ID_SYARAT = 11 THEN KET_SYARAT END) AS KET_SYARAT_3,
                MAX(CASE WHEN ID_SYARAT = 11 THEN STATUS END)     AS STATUS_3,
                MAX(CASE WHEN ID_SYARAT = 11 THEN KETERANGAN END) AS KETERANGAN_3,
                MAX(CASE WHEN ID_SYARAT = 12 THEN KET_SYARAT END) AS KET_SYARAT_4,
                MAX(CASE WHEN ID_SYARAT = 12 THEN STATUS END)     AS STATUS_4,
                MAX(CASE WHEN ID_SYARAT = 12 THEN KETERANGAN END) AS KETERANGAN_4,
                MAX(CASE WHEN ID_SYARAT = 13 THEN KET_SYARAT END) AS KET_SYARAT_5,
                MAX(CASE WHEN ID_SYARAT = 13 THEN STATUS END)     AS STATUS_5,
                MAX(CASE WHEN ID_SYARAT = 13 THEN KETERANGAN END) AS KETERANGAN_5,
                MAX(CASE WHEN ID_SYARAT = 14 THEN KET_SYARAT END) AS KET_SYARAT_6,
                MAX(CASE WHEN ID_SYARAT = 14 THEN STATUS END)     AS STATUS_6,
                MAX(CASE WHEN ID_SYARAT = 14 THEN KETERANGAN END) AS KETERANGAN_6,
                MAX(CASE WHEN ID_SYARAT = 15 THEN KET_SYARAT END) AS KET_SYARAT_7,
                MAX(CASE WHEN ID_SYARAT = 15 THEN STATUS END)     AS STATUS_7,
                MAX(CASE WHEN ID_SYARAT = 15 THEN KETERANGAN END) AS KETERANGAN_7
                FROM HD
                GROUP BY TGL_SURAT_PERMOHONAN, TGL_TERIMA_DOKUMEN, NOPEL, NO_SRT_PERMOHONAN, NAMA_PEMOHON, KET_VERLAP, REKOM_VERLAP,
                ALAMAT_PEMOHON, NOP, NM_WP, ALAMAT_OP, THN_PAJAK_SPPT, TGL_BAP_LAPANGAN, NO_BAP_LAPANGAN,  TGL_SK, NO_SK,
                PROSES_PK, ANALISA_PK, KETERANGAN_PK, PROSES_PL, ANALISA_PL, KETERANGAN_PL, NM_KECAMATAN,
                KETETAPAN, KETETAPAN_AWAL, FAKTOR_PENGURANG, ALAMAT_WP, JTH_TEMPO, JTH_TEMPO_AWAL,
                TERBILANG_KETETAPAN, TERBILANG_KETETAPAN_AWAL,
                PCT_DISETUJUI, TX_PCT, TX_STS_PENGURANGAN, KESIMPULAN_BA, DESC_PENELITIAN_1]]>
	</queryString>
	<field name="TGL_SURAT_PERMOHONAN" class="java.lang.String"/>
	<field name="TGL_TERIMA_DOKUMEN" class="java.lang.String"/>
	<field name="NOPEL" class="java.lang.String"/>
