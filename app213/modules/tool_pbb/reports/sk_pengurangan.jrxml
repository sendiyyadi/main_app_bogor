					<font fontName="SansSerif"/>
				</textElement>
				<textFieldExpression><![CDATA["Pemohon adalah " + $F{DESC_PENELITIAN_1}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="34" y="646" width="15" height="15" uuid="d417faf4-5724-4944-adc3-09fa9ddb175e"/>
				<textElement verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[2.]]></text>
			</staticText>
			<staticText>
				<reportElement x="49" y="646" width="496" height="65" uuid="2db0e189-fe6f-4269-9869-a848c6255de6"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[Berdasarkan ketentuan Pasal 138 ayat (3) Peraturan Daerah Nomor 11 tahun 2023 tentang Pajak Daerah dan Retribusi Daerah, bahwa Kondisi Objek Pajak sebagaimana dimaksud pada ayat (1) meliputi lahan pertanian yang sangat terbatas, tanah dan bangunan yang ditempati Wajib Pajak dari golongan tertentu, nilai Objek Pajak sampai dengan batas tertentu, dan Objek Pajak yang terdampak bencana alam, kebakaran, huru-hara, dan/atau kerusuhan.]]></text>
			</staticText>
		</band>
		<band height="512">
			<staticText>
				<reportElement x="32" y="3" width="15" height="15" uuid="49a9dc1e-08e7-4efc-b4cf-1238f9a5390b"/>
				<textElement verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[3.]]></text>
			</staticText>
			<staticText>
				<reportElement x="47" y="3" width="496" height="91" uuid="e0d4d4c9-3401-494d-8a68-50cfe73277c1"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[Berdasarkan ketentuan Pasal 62 ayat (2) huruf a nomor 1 huruf c Peraturan Bupati Bogor Nomor 46 tahun 2019 tentang Petunjuk Pelaksanaan Administrasi Pajak Bumi dan Bangunan Perdesaan dan Perkotaan sebagaimana telah diubah dengan Peraturan Bupati Bogor Nomor 65 Tahun 2019 tentang Perubahan Atas Peraturan Bupati Bogor Nomor 46 Tahun 2019 tentang Petunjuk Pelaksanaan Bupati atau Kepala Bappenda dapat memberikan pengurangan pajak kepada Wajib Pajak berpenghasilan rendah atau dibawah upah minimum Daerah sehingga mengalami kesulitan untuk memenuhi kewajiban pajaknya, diberikan pengurangan atas objek pajak yang ditempati oleh Wajib Pajak maksimal sebesar 50% (lima puluh perseratus).]]></text>
			</staticText>
			<staticText>
				<reportElement x="47" y="95" width="496" height="13" uuid="8de6075d-1add-438e-80cf-4dc7abb42c5b"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[Objek Pajak yang diajukan pengurangan merupakan Objek Pajak yang ditempati oleh Wajib Pajak.]]></text>
			</staticText>
			<staticText>
				<reportElement x="32" y="95" width="15" height="15" uuid="3483194d-74fd-4e9a-8e83-a8d9169984fa"/>
				<textElement verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[4.]]></text>
			</staticText>
			<staticText>
				<reportElement x="32" y="110" width="15" height="15" uuid="0466045d-5fe0-4943-9e28-610458ebcba9"/>
				<textElement verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[5.]]></text>
