				<textElement verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[3.]]></text>
			</staticText>
			<staticText>
				<reportElement x="49" y="297" width="496" height="26" uuid="d6039515-7410-4427-af36-cadc51636ae8"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
				<text><![CDATA[Undang-Undang Nomor 1 Tahun 2022 tentang Hubungan Keuangan antara Pemerintah Pusat dan Pemerintahan Daerah;]]></text>
			</staticText>
			<staticText>
				<reportElement x="34" y="323" width="15" height="15" uuid="edc82a90-4377-4f86-b2d4-304762c16c0f"/>
				<textElement verticalAlignment="Top">
					<font fontName="SansSerif" size="10" isBold="false"/>
				</textElement>
