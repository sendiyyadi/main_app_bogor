	<queryString>
		<![CDATA[SELECT V_CTT_PMB.*, SYSDATE as TGL_CETAK FROM V_CTT_PMB
                WHERE KETETAPAN <= (JML_BAYAR - JML_DENDA)
                AND KD_PROPINSI = '$P!{prop_kd}' AND KD_DATI2 = '$P!{kab_kd}'
                AND KD_KECAMATAN = '$P!{kec_kd}' AND KD_KELURAHAN = '$P!{kel_kd}'
                AND KD_BLOK = '$P!{blok_kd}' AND NO_URUT = '$P!{urut_no}'
                AND KD_JNS_OP = '$P!{jns_kd}']]>
	</queryString>
