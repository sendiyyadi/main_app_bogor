<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sppt_rpt" language="groovy" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="7e4c4947-3383-4c94-8927-c49abfb86d1b">
	<property name="ireport.zoom" value="1.4641000000000128"/>
	<property name="ireport.x" value="32"/>
	<property name="ireport.y" value="117"/>
	<property name="ireport.background.image.properties" value="true,true,1.0,-8,-8,0,0,611,954"/>
	<parameter name="background_img" class="java.lang.String"/>
	<parameter name="terbilang_bayarpbb" class="java.lang.String"/>
	<parameter name="kd_prop" class="java.lang.String"/>
	<parameter name="kd_dati2" class="java.lang.String"/>
	<parameter name="kd_kecamatan" class="java.lang.String"/>
	<parameter name="kd_kelurahan" class="java.lang.String"/>
	<parameter name="kd_blok" class="java.lang.String"/>
	<parameter name="no_urut" class="java.lang.String"/>
	<parameter name="kd_jns_op" class="java.lang.String"/>
	<parameter name="nm_pejabat" class="java.lang.String"/>
	<parameter name="nip_pejabat" class="java.lang.String"/>
	<parameter name="img_qr" class="java.lang.String"/>
	<parameter name="blanko_back" class="java.lang.String"/>
	<parameter name="logo_bsre" class="java.lang.String"/>
	<parameter name="tahun_sppt" class="java.lang.String"/>
	<parameter name="tahun_sppt_1" class="java.lang.String"/>
	<parameter name="tahun_sppt_2" class="java.lang.String"/>
	<parameter name="tahun_sppt_3" class="java.lang.String"/>
	<parameter name="tahun_sppt_4" class="java.lang.String"/>
	<parameter name="tahun_sppt_5" class="java.lang.String"/>
	<parameter name="tahun_sppt_6" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 'HEAD' AS XXX, ROW_NUMBER() OVER (ORDER BY S.THN_PAJAK_SPPT DESC) URUT_X,
S.KD_PROPINSI||'.'||S.KD_DATI2||'.'||S.KD_KECAMATAN||'.'||S.KD_KELURAHAN||'.'||S.KD_BLOK||'.'||S.NO_URUT||'.'||S.KD_JNS_OP AS NOP,
S.THN_PAJAK_SPPT, S.NM_WP_SPPT, S.JLN_WP_SPPT, NVL(S.BLOK_KAV_NO_WP_SPPT, ' ') AS BLOK_KAV_NO_WP_SPPT, NVL(S.RT_WP_SPPT,' ') AS RT_WP_SPPT,
NVL(S.RW_WP_SPPT,' ') AS RW_WP_SPPT, NVL(S.KELURAHAN_WP_SPPT,' ') AS KELURAHAN_WP_SPPT, NVL(S.KOTA_WP_SPPT,' ') AS KOTA_WP_SPPT,
S.TGL_CETAK_SPPT, OP.JALAN_OP, NVL(OP.BLOK_KAV_NO_OP,' ') AS BLOK_KAV_NO_OP, NVL(OP.RT_OP,' ') AS RT_OP, NVL(OP.RW_OP,' ') AS RW_OP,
KEC_OP.NM_KECAMATAN AS KECAMATAN_OP, KEL_OP.NM_KELURAHAN AS KELURAHAN_OP, DT_OP.NM_DATI2,
S.LUAS_BUMI_SPPT, S.NJOP_BUMI_SPPT, S.LUAS_BNG_SPPT, S.NJOP_BNG_SPPT, S.NJOP_SPPT, S.NJOPTKP_SPPT,
(S.NJOP_SPPT - S.NJOPTKP_SPPT) AS NJOPKP_SPPT, S.TARIF_SPPT, S.PBB_TERHUTANG_SPPT, S.FAKTOR_PENGURANG_SPPT,
S.PBB_YG_HARUS_DIBAYAR_SPPT, S.KD_KLS_BNG, S.KD_KLS_TANAH,
CASE WHEN S.FAKTOR_PENGURANG_SPPT > 0 THEN S.FAKTOR_PENGURANG_SPPT ELSE NULL END AS FAKTOR_PENGURANG_SPPT_2,
CASE WHEN S.FAKTOR_PENGURANG_SPPT > 0 THEN 'Faktor Pengurang/Kebijakan Pengenaan' ELSE '' END AS TXT_FAKTOR_PENGURANG,
TERBILANG(S.PBB_YG_HARUS_DIBAYAR_SPPT) AS TXT_TERBILANG, FMT_TGL_TEKS(S.TGL_JATUH_TEMPO_SPPT) AS TGL_JATUH_TEMPO,
FMT_TGL_TEKS(SYSDATE) AS TGL_CETAK,
FMT_TGL_TEKS(S.TGL_CETAK_SPPT) AS TGL_CETAK_SPPT_2,
SP1.THN_PAJAK_SPPT THN1, NVL(SP1.PBB_YG_HARUS_DIBAYAR_SPPT, 0) AS POKOK1, NVL(SP1.DENDA_SPPT, 0) AS DENDA1,
CASE WHEN SP1.SISA <= 0 THEN 0 ELSE NVL(SP1.SISA, 0) END AS SISA1,
SP2.THN_PAJAK_SPPT THN2, NVL(SP2.PBB_YG_HARUS_DIBAYAR_SPPT, 0) AS POKOK2, NVL(SP2.DENDA_SPPT, 0) AS DENDA2,
CASE WHEN SP2.SISA <= 0 THEN 0 ELSE NVL(SP2.SISA, 0) END AS SISA2,
SP3.THN_PAJAK_SPPT THN3, NVL(SP3.PBB_YG_HARUS_DIBAYAR_SPPT, 0) AS POKOK3, NVL(SP3.DENDA_SPPT, 0) AS DENDA3,
CASE WHEN SP3.SISA <= 0 THEN 0 ELSE NVL(SP3.SISA, 0) END AS SISA3,
SP4.THN_PAJAK_SPPT THN4, NVL(SP4.PBB_YG_HARUS_DIBAYAR_SPPT, 0) AS POKOK4, NVL(SP4.DENDA_SPPT, 0) AS DENDA4,
CASE WHEN SP4.SISA <= 0 THEN 0 ELSE NVL(SP4.SISA, 0) END AS SISA4,
SP5.THN_PAJAK_SPPT THN5, NVL(SP5.PBB_YG_HARUS_DIBAYAR_SPPT, 0) AS POKOK5, NVL(SP5.DENDA_SPPT, 0) AS DENDA5,
CASE WHEN SP5.SISA <= 0 THEN 0 ELSE NVL(SP5.SISA, 0) END AS SISA5,
$P{tahun_sppt_6} THN6, NVL(SPM.PBB_YG_HARUS_DIBAYAR_SPPT, 0) AS POKOK6, NVL(SPM.DENDA_SPPT, 0) AS DENDA6,
CASE WHEN SPM.SISA <= 0 THEN 0 ELSE NVL(SPM.SISA, 0) END AS SISA6,
0 AS JML_BAYAR, '' AS TGL_BAYAR, '' AS STS_BYR

FROM SPPT S
LEFT JOIN (SELECT S1.KD_PROPINSI, S1.KD_DATI2, S1.KD_KECAMATAN, S1.KD_KELURAHAN, S1.KD_BLOK, S1.NO_URUT, S1.KD_JNS_OP,
	  S1.THN_PAJAK_SPPT, S1.PBB_YG_HARUS_DIBAYAR_SPPT, PS1.DENDA_SPPT,
	  (S1.PBB_YG_HARUS_DIBAYAR_SPPT - S1.FAKTOR_PENGURANG_SPPT - PS1.JML_SPPT_YG_DIBAYAR) AS SISA
	  FROM SPPT S1
	  LEFT JOIN PEMBAYARAN_SPPT PS1 ON S1.KD_PROPINSI=PS1.KD_PROPINSI  AND S1.KD_DATI2=PS1.KD_DATI2
	  	AND S1.KD_KECAMATAN=PS1.KD_KECAMATAN AND S1.KD_KELURAHAN=PS1.KD_KELURAHAN
	  	AND S1.KD_BLOK=PS1.KD_BLOK AND S1.NO_URUT=PS1.NO_URUT AND S1.KD_JNS_OP=PS1.KD_JNS_OP
	  	AND S1.THN_PAJAK_SPPT=PS1.THN_PAJAK_SPPT
	  	WHERE S1.KD_PROPINSI=$P{kd_prop} AND S1.KD_DATI2=$P{kd_dati2} AND S1.KD_KECAMATAN=$P{kd_kecamatan}
		AND S1.KD_KELURAHAN=$P{kd_kelurahan} AND S1.KD_BLOK=$P{kd_blok} AND S1.NO_URUT=$P{no_urut}
		AND S1.KD_JNS_OP=$P{kd_jns_op} AND S1.THN_PAJAK_SPPT = $P{tahun_sppt_1}
	 ) SP1 ON SP1.KD_PROPINSI=S.KD_PROPINSI  AND SP1.KD_DATI2=S.KD_DATI2
  	AND SP1.KD_KECAMATAN=S.KD_KECAMATAN AND SP1.KD_KELURAHAN=S.KD_KELURAHAN
  	AND SP1.KD_BLOK=S.KD_BLOK AND SP1.NO_URUT=S.NO_URUT AND SP1.KD_JNS_OP=S.KD_JNS_OP
LEFT JOIN (SELECT S1.KD_PROPINSI, S1.KD_DATI2, S1.KD_KECAMATAN, S1.KD_KELURAHAN, S1.KD_BLOK, S1.NO_URUT, S1.KD_JNS_OP,
	  S1.THN_PAJAK_SPPT, S1.PBB_YG_HARUS_DIBAYAR_SPPT, PS1.DENDA_SPPT,
	  (S1.PBB_YG_HARUS_DIBAYAR_SPPT - S1.FAKTOR_PENGURANG_SPPT - PS1.JML_SPPT_YG_DIBAYAR) AS SISA
	  FROM SPPT S1
	  LEFT JOIN PEMBAYARAN_SPPT PS1 ON S1.KD_PROPINSI=PS1.KD_PROPINSI  AND S1.KD_DATI2=PS1.KD_DATI2
	  	AND S1.KD_KECAMATAN=PS1.KD_KECAMATAN AND S1.KD_KELURAHAN=PS1.KD_KELURAHAN
	  	AND S1.KD_BLOK=PS1.KD_BLOK AND S1.NO_URUT=PS1.NO_URUT AND S1.KD_JNS_OP=PS1.KD_JNS_OP
	  	AND S1.THN_PAJAK_SPPT=PS1.THN_PAJAK_SPPT
	  	WHERE S1.KD_PROPINSI=$P{kd_prop} AND S1.KD_DATI2=$P{kd_dati2} AND S1.KD_KECAMATAN=$P{kd_kecamatan}
		AND S1.KD_KELURAHAN=$P{kd_kelurahan} AND S1.KD_BLOK=$P{kd_blok} AND S1.NO_URUT=$P{no_urut}
		AND S1.KD_JNS_OP=$P{kd_jns_op} AND S1.THN_PAJAK_SPPT = $P{tahun_sppt_2}
	 ) SP2 ON SP2.KD_PROPINSI=S.KD_PROPINSI  AND SP2.KD_DATI2=S.KD_DATI2
  	AND SP2.KD_KECAMATAN=S.KD_KECAMATAN AND SP2.KD_KELURAHAN=S.KD_KELURAHAN
  	AND SP2.KD_BLOK=S.KD_BLOK AND SP2.NO_URUT=S.NO_URUT AND SP2.KD_JNS_OP=S.KD_JNS_OP
LEFT JOIN (SELECT S1.KD_PROPINSI, S1.KD_DATI2, S1.KD_KECAMATAN, S1.KD_KELURAHAN, S1.KD_BLOK, S1.NO_URUT, S1.KD_JNS_OP,
	  S1.THN_PAJAK_SPPT, S1.PBB_YG_HARUS_DIBAYAR_SPPT, PS1.DENDA_SPPT,
	  (S1.PBB_YG_HARUS_DIBAYAR_SPPT - S1.FAKTOR_PENGURANG_SPPT - PS1.JML_SPPT_YG_DIBAYAR) AS SISA
	  FROM SPPT S1
	  LEFT JOIN PEMBAYARAN_SPPT PS1 ON S1.KD_PROPINSI=PS1.KD_PROPINSI  AND S1.KD_DATI2=PS1.KD_DATI2
	  	AND S1.KD_KECAMATAN=PS1.KD_KECAMATAN AND S1.KD_KELURAHAN=PS1.KD_KELURAHAN
	  	AND S1.KD_BLOK=PS1.KD_BLOK AND S1.NO_URUT=PS1.NO_URUT AND S1.KD_JNS_OP=PS1.KD_JNS_OP
	  	AND S1.THN_PAJAK_SPPT=PS1.THN_PAJAK_SPPT
	  	WHERE S1.KD_PROPINSI=$P{kd_prop} AND S1.KD_DATI2=$P{kd_dati2} AND S1.KD_KECAMATAN=$P{kd_kecamatan}
		AND S1.KD_KELURAHAN=$P{kd_kelurahan} AND S1.KD_BLOK=$P{kd_blok} AND S1.NO_URUT=$P{no_urut}
		AND S1.KD_JNS_OP=$P{kd_jns_op} AND S1.THN_PAJAK_SPPT = $P{tahun_sppt_3}
	 ) SP3 ON SP3.KD_PROPINSI=S.KD_PROPINSI  AND SP3.KD_DATI2=S.KD_DATI2
  	AND SP3.KD_KECAMATAN=S.KD_KECAMATAN AND SP3.KD_KELURAHAN=S.KD_KELURAHAN
  	AND SP3.KD_BLOK=S.KD_BLOK AND SP3.NO_URUT=S.NO_URUT AND SP3.KD_JNS_OP=S.KD_JNS_OP
LEFT JOIN (SELECT S1.KD_PROPINSI, S1.KD_DATI2, S1.KD_KECAMATAN, S1.KD_KELURAHAN, S1.KD_BLOK, S1.NO_URUT, S1.KD_JNS_OP,
	  S1.THN_PAJAK_SPPT, S1.PBB_YG_HARUS_DIBAYAR_SPPT, PS1.DENDA_SPPT,
	  (S1.PBB_YG_HARUS_DIBAYAR_SPPT - S1.FAKTOR_PENGURANG_SPPT - PS1.JML_SPPT_YG_DIBAYAR) AS SISA
	  FROM SPPT S1
	  LEFT JOIN PEMBAYARAN_SPPT PS1 ON S1.KD_PROPINSI=PS1.KD_PROPINSI  AND S1.KD_DATI2=PS1.KD_DATI2
	  	AND S1.KD_KECAMATAN=PS1.KD_KECAMATAN AND S1.KD_KELURAHAN=PS1.KD_KELURAHAN
	  	AND S1.KD_BLOK=PS1.KD_BLOK AND S1.NO_URUT=PS1.NO_URUT AND S1.KD_JNS_OP=PS1.KD_JNS_OP
	  	AND S1.THN_PAJAK_SPPT=PS1.THN_PAJAK_SPPT
	  	WHERE S1.KD_PROPINSI=$P{kd_prop} AND S1.KD_DATI2=$P{kd_dati2} AND S1.KD_KECAMATAN=$P{kd_kecamatan}
		AND S1.KD_KELURAHAN=$P{kd_kelurahan} AND S1.KD_BLOK=$P{kd_blok} AND S1.NO_URUT=$P{no_urut}
		AND S1.KD_JNS_OP=$P{kd_jns_op} AND S1.THN_PAJAK_SPPT = $P{tahun_sppt_4}
	 ) SP4 ON SP4.KD_PROPINSI=S.KD_PROPINSI  AND SP4.KD_DATI2=S.KD_DATI2
  	AND SP4.KD_KECAMATAN=S.KD_KECAMATAN AND SP4.KD_KELURAHAN=S.KD_KELURAHAN
  	AND SP4.KD_BLOK=S.KD_BLOK AND SP4.NO_URUT=S.NO_URUT AND SP4.KD_JNS_OP=S.KD_JNS_OP
LEFT JOIN (SELECT S1.KD_PROPINSI, S1.KD_DATI2, S1.KD_KECAMATAN, S1.KD_KELURAHAN, S1.KD_BLOK, S1.NO_URUT, S1.KD_JNS_OP,
	  S1.THN_PAJAK_SPPT, S1.PBB_YG_HARUS_DIBAYAR_SPPT, PS1.DENDA_SPPT,
	  (S1.PBB_YG_HARUS_DIBAYAR_SPPT - S1.FAKTOR_PENGURANG_SPPT - PS1.JML_SPPT_YG_DIBAYAR) AS SISA
	  FROM SPPT S1
	  LEFT JOIN PEMBAYARAN_SPPT PS1 ON S1.KD_PROPINSI=PS1.KD_PROPINSI  AND S1.KD_DATI2=PS1.KD_DATI2
	  	AND S1.KD_KECAMATAN=PS1.KD_KECAMATAN AND S1.KD_KELURAHAN=PS1.KD_KELURAHAN
	  	AND S1.KD_BLOK=PS1.KD_BLOK AND S1.NO_URUT=PS1.NO_URUT AND S1.KD_JNS_OP=PS1.KD_JNS_OP
	  	AND S1.THN_PAJAK_SPPT=PS1.THN_PAJAK_SPPT
	  	WHERE S1.KD_PROPINSI=$P{kd_prop} AND S1.KD_DATI2=$P{kd_dati2} AND S1.KD_KECAMATAN=$P{kd_kecamatan}
		AND S1.KD_KELURAHAN=$P{kd_kelurahan} AND S1.KD_BLOK=$P{kd_blok} AND S1.NO_URUT=$P{no_urut}
		AND S1.KD_JNS_OP=$P{kd_jns_op} AND S1.THN_PAJAK_SPPT = $P{tahun_sppt_5}
	 ) SP5 ON SP5.KD_PROPINSI=S.KD_PROPINSI  AND SP5.KD_DATI2=S.KD_DATI2
  	AND SP5.KD_KECAMATAN=S.KD_KECAMATAN AND SP5.KD_KELURAHAN=S.KD_KELURAHAN
  	AND SP5.KD_BLOK=S.KD_BLOK AND SP5.NO_URUT=S.NO_URUT AND SP5.KD_JNS_OP=S.KD_JNS_OP

LEFT JOIN (SELECT S1.KD_PROPINSI, S1.KD_DATI2, S1.KD_KECAMATAN, S1.KD_KELURAHAN, S1.KD_BLOK, S1.NO_URUT, S1.KD_JNS_OP,
	  SUM(S1.PBB_YG_HARUS_DIBAYAR_SPPT) AS PBB_YG_HARUS_DIBAYAR_SPPT, SUM(PS1.DENDA_SPPT) AS DENDA_SPPT,
	  (SUM(S1.PBB_YG_HARUS_DIBAYAR_SPPT) - SUM(PS1.JML_SPPT_YG_DIBAYAR)) AS SISA_2,
      (SUM(S1.PBB_YG_HARUS_DIBAYAR_SPPT) - SUM(S1.FAKTOR_PENGURANG_SPPT)  - (SUM(PS1.JML_SPPT_YG_DIBAYAR) - SUM(PS1.DENDA_SPPT))) as SISA
	  FROM SPPT S1
	  LEFT JOIN PEMBAYARAN_SPPT PS1 ON S1.KD_PROPINSI=PS1.KD_PROPINSI  AND S1.KD_DATI2=PS1.KD_DATI2
	  	AND S1.KD_KECAMATAN=PS1.KD_KECAMATAN AND S1.KD_KELURAHAN=PS1.KD_KELURAHAN
	  	AND S1.KD_BLOK=PS1.KD_BLOK AND S1.NO_URUT=PS1.NO_URUT AND S1.KD_JNS_OP=PS1.KD_JNS_OP
	  	AND S1.THN_PAJAK_SPPT=PS1.THN_PAJAK_SPPT
	  	WHERE S1.KD_PROPINSI=$P{kd_prop} AND S1.KD_DATI2=$P{kd_dati2} AND S1.KD_KECAMATAN=$P{kd_kecamatan}
		AND S1.KD_KELURAHAN=$P{kd_kelurahan} AND S1.KD_BLOK=$P{kd_blok} AND S1.NO_URUT=$P{no_urut}
		AND S1.KD_JNS_OP=$P{kd_jns_op} AND S1.THN_PAJAK_SPPT <= $P{tahun_sppt_6}
	  GROUP BY S1.KD_PROPINSI, S1.KD_DATI2, S1.KD_KECAMATAN, S1.KD_KELURAHAN, S1.KD_BLOK, S1.NO_URUT, S1.KD_JNS_OP
	 ) SPM ON SPM.KD_PROPINSI=S.KD_PROPINSI  AND SPM.KD_DATI2=S.KD_DATI2
  	AND SPM.KD_KECAMATAN=S.KD_KECAMATAN AND SPM.KD_KELURAHAN=S.KD_KELURAHAN
  	AND SPM.KD_BLOK=S.KD_BLOK AND SPM.NO_URUT=S.NO_URUT AND SPM.KD_JNS_OP=S.KD_JNS_OP

JOIN DAT_OBJEK_PAJAK OP ON S.KD_PROPINSI=OP.KD_PROPINSI AND S.KD_DATI2=OP.KD_DATI2 AND S.KD_KECAMATAN=OP.KD_KECAMATAN
	AND S.KD_KELURAHAN=OP.KD_KELURAHAN AND S.KD_BLOK=OP.KD_BLOK  AND S.NO_URUT=OP.NO_URUT
JOIN REF_DATI2 DT_OP ON DT_OP.KD_PROPINSI=OP.KD_PROPINSI AND DT_OP.KD_DATI2=OP.KD_DATI2
JOIN REF_KECAMATAN KEC_OP ON KEC_OP.KD_PROPINSI=OP.KD_PROPINSI AND KEC_OP.KD_DATI2=OP.KD_DATI2
	AND KEC_OP.KD_KECAMATAN=OP.KD_KECAMATAN
JOIN REF_KELURAHAN KEL_OP ON KEL_OP.KD_PROPINSI=OP.KD_PROPINSI AND KEL_OP.KD_DATI2=OP.KD_DATI2
	AND KEL_OP.KD_KECAMATAN=OP.KD_KECAMATAN AND KEL_OP.KD_KELURAHAN=OP.KD_KELURAHAN
WHERE S.KD_PROPINSI=$P{kd_prop} AND S.KD_DATI2=$P{kd_dati2} AND S.KD_KECAMATAN=$P{kd_kecamatan}
	AND S.KD_KELURAHAN=$P{kd_kelurahan} AND S.KD_BLOK=$P{kd_blok} AND S.NO_URUT=$P{no_urut}
	AND S.KD_JNS_OP=$P{kd_jns_op} AND S.THN_PAJAK_SPPT = $P{tahun_sppt}

UNION ALL

SELECT 'DETAIL' AS XXX, ROW_NUMBER() OVER (ORDER BY S.THN_PAJAK_SPPT DESC) URUT_X,
S.KD_PROPINSI||'.'||S.KD_DATI2||'.'||S.KD_KECAMATAN||'.'||S.KD_KELURAHAN||'.'||S.KD_BLOK||'.'||S.NO_URUT||'.'||S.KD_JNS_OP AS NOP,
S.THN_PAJAK_SPPT, S.NM_WP_SPPT, S.JLN_WP_SPPT, '' AS BLOK_KAV_NO_WP_SPPT, '' AS RT_WP_SPPT, '' AS RW_WP_SPPT,
'' AS KELURAHAN_WP_SPPT, '' AS KOTA_WP_SPPT, S.TGL_CETAK_SPPT, '' AS JALAN_OP, '' AS BLOK_KAV_NO_OP, '' AS RT_OP, '' AS RW_OP,
'' AS KECAMATAN_OP, '' AS KELURAHAN_OP, '' AS NM_DATI2, 0 AS LUAS_BUMI_SPPT, 0 AS NJOP_BUMI_SPPT, 0 AS LUAS_BNG_SPPT, 0 AS NJOP_BNG_SPPT,
0 AS NJOP_SPPT, 0 AS NJOPTKP_SPPT, 0 AS NJOPKP_SPPT, 0 AS TARIF_SPPT, S.PBB_TERHUTANG_SPPT, S.FAKTOR_PENGURANG_SPPT,
S.PBB_YG_HARUS_DIBAYAR_SPPT, '' AS KD_KLS_BNG, '' AS KD_KLS_TANAH,
NULL AS FAKTOR_PENGURANG_SPPT_2,
'' AS TXT_FAKTOR_PENGURANG, '' AS TXT_TERBILANG, '' AS TGL_JATUH_TEMPO,
FMT_TGL_TEKS(SYSDATE) AS TGL_CETAK,
'' AS TGL_CETAK_SPPT_2,
'' AS THN1, 0 AS POKOK1, 0 AS DENDA1, 0 AS SISA1,
'' AS THN2, 0 AS POKOK2, 0 AS DENDA2, 0 AS SISA2,
'' AS THN3, 0 AS POKOK3, 0 AS DENDA3, 0 AS SISA3,
'' AS THN4, 0 AS POKOK4, 0 AS DENDA4, 0 AS SISA4,
'' AS THN5, 0 AS POKOK5, 0 AS DENDA5, 0 AS SISA5,
'' AS THN6, 0 AS POKOK6, 0 AS DENDA6, 0 AS SISA6,
PS.JML_BAYAR, TO_CHAR(PS.TGL_BAYAR,'DD-MM-YYYY') AS TGL_BAYAR,
CASE WHEN PS.JML_BAYAR >= S.PBB_YG_HARUS_DIBAYAR_SPPT THEN 'LUNAS' ELSE 'BELUM LUNAS' END AS STS_BYR

FROM SPPT S
LEFT JOIN (SELECT KD_PROPINSI, KD_DATI2, KD_KECAMATAN, KD_KELURAHAN, KD_BLOK, NO_URUT, KD_JNS_OP, THN_PAJAK_SPPT,
			SUM(JML_SPPT_YG_DIBAYAR) AS JML_BAYAR, MAX(TGL_PEMBAYARAN_SPPT) AS TGL_BAYAR FROM PEMBAYARAN_SPPT
			GROUP BY KD_PROPINSI, KD_DATI2, KD_KECAMATAN, KD_KELURAHAN, KD_BLOK, NO_URUT, KD_JNS_OP, THN_PAJAK_SPPT
) PS
	ON S.KD_PROPINSI=PS.KD_PROPINSI AND S.KD_DATI2=PS.KD_DATI2
  	AND S.KD_KECAMATAN=PS.KD_KECAMATAN AND S.KD_KELURAHAN=PS.KD_KELURAHAN
  	AND S.KD_BLOK=PS.KD_BLOK AND S.NO_URUT=PS.NO_URUT AND S.KD_JNS_OP=PS.KD_JNS_OP
  	AND S.THN_PAJAK_SPPT=PS.THN_PAJAK_SPPT

WHERE S.KD_PROPINSI=$P{kd_prop} AND S.KD_DATI2=$P{kd_dati2} AND S.KD_KECAMATAN=$P{kd_kecamatan}
	AND S.KD_KELURAHAN=$P{kd_kelurahan} AND S.KD_BLOK=$P{kd_blok} AND S.NO_URUT=$P{no_urut}
	AND S.KD_JNS_OP=$P{kd_jns_op}

ORDER BY THN_PAJAK_SPPT DESC]]>
	</queryString>
