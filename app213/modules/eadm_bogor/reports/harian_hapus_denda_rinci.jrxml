	<detail>
		<band height="17" splitType="Stretch">
			<textField isBlankWhenNull="false">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="71" height="17" uuid="f80896e0-17f2-4c29-9d9f-f5d2a593b6a2"/>
