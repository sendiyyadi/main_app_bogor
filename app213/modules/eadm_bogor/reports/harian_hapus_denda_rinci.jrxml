				<textFieldExpression><![CDATA[$F{thn_pajak_sppt}]]></textFieldExpression>
			</textField>
			<textField pattern="dd-MM-yyyy" isBlankWhenNull="false">
				<reportElement stretchType="RelativeToTallestObject" x="71" y="0" width="66" height="17" uuid="e23d836a-b176-40ad-a0f5-d6ec7667aaa0"/>
				<box>
