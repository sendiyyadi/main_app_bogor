	<queryString>
		<![CDATA[SELECT P.THN_PELAYANAN, P.BUNDEL_PELAYANAN, P.NO_URUT_PELAYANAN, RP.NM_JENIS_PELAYANAN, CASE WHEN P.TGL_SURAT_PERMOHONAN IS NULL THEN '-' ELSE TO_CHAR(P.TGL_SURAT_PERMOHONAN,'DD-MM-YYYY') END AS TGL_SURAT_PERMOHONAN, NVL(P.ALASAN,'-') AS ALASAN, P.KD_PROPINSI_PEMOHON, P.KD_DATI2_PEMOHON, P.KD_KECAMATAN_PEMOHON, P.KD_KELURAHAN_PEMOHON, P.KD_BLOK_PEMOHON, P.NO_URUT_PEMOHON, P.KD_JNS_OP_PEMOHON, P.NIK_PENGIRIM, P.NAMA_PEMOHON FROM PST_PERMOHONAN_ONLINE P LEFT JOIN REF_JNS_PELAYANAN RP ON RP.KD_JNS_PELAYANAN=P.KD_JNS_PELAYANAN WHERE P.THN_PELAYANAN = $P{thn_ply} AND P.BUNDEL_PELAYANAN=$P{bundel_ply} AND P.NO_URUT_PELAYANAN = $P{no_urut_ply} AND P.KD_PROPINSI_PEMOHON = $P{kd_propinsi} AND P.KD_DATI2_PEMOHON=$P{kd_dati2} AND P.KD_KECAMATAN_PEMOHON=$P{kd_kecamatan} AND P.KD_KELURAHAN_PEMOHON=$P{kd_kelurahan} AND P.KD_BLOK_PEMOHON=$P{kd_blok} AND P.NO_URUT_PEMOHON=$P{no_urut} AND P.KD_JNS_OP_PEMOHON=$P{kd_jns_op}]]>
	</queryString>
